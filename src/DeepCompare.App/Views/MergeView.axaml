<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.MergeView"
             x:DataType="vm:MergeViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- 上の帯 -->
    <Border Grid.Row="0" Classes="topbar">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="3 方向マージ" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="6,0,0,0" />
          <TextBlock VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource FgDim}"
                     Text="競合は決めるまで未決のままにします。勝手に片方を採りません" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="祖先" VerticalAlignment="Center"
                     Margin="0,0,8,4" Width="34" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BasePath}" Margin="0,0,0,4"
                   PlaceholderText="共通の元になったファイル" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="左" VerticalAlignment="Center"
                     Margin="0,0,8,4" Width="34" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LeftPath}" Margin="0,0,0,4" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="右" VerticalAlignment="Center"
                     Margin="0,0,8,0" Width="34" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RightPath}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
                ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
          <Path Classes="icon" Data="{StaticResource IconHome}" />
        </Button>
        <Border Classes="vsep" />
          <Button Classes="icon" Command="{Binding MergeCommand}" IsEnabled="{Binding !Busy}"
                  ToolTip.Tip="マージする">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" />
          </Button>
          <Border Classes="vsep" />
          <Button Classes="icon" Command="{Binding TakeAllLeftCommand}"
                  ToolTip.Tip="競合を全部「左を採る」で決める">
            <Path Classes="icon" Data="{StaticResource IconToLeft}" />
          </Button>
          <Button Classes="icon" Command="{Binding TakeAllRightCommand}"
                  ToolTip.Tip="競合を全部「右を採る」で決める">
            <Path Classes="icon" Data="{StaticResource IconToRight}" />
          </Button>
          <Border Classes="vsep" />
          <!-- 用途で意味が変わる（書き出す／解決したことにする）ので、言葉も添える -->
          <Button Classes="icon" Command="{Binding SaveCommand}"
                  ToolTip.Tip="{Binding SaveLabel}">
            <Path Classes="icon" Data="{StaticResource IconExport}" />
          </Button>
          <ToggleButton Classes="filter" IsChecked="{Binding ShowUnchanged}"
                        ToolTip.Tip="変化のない部分も出す">
            <Path Classes="icon" Data="{StaticResource IconFilterAll}" />
          </ToggleButton>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}"
                       Width="70" VerticalAlignment="Center" Margin="6,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- まとまりの一覧 -->
    <ScrollViewer Grid.Row="1" Margin="12,8">
      <ItemsControl ItemsSource="{Binding Regions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MergeRegionRow">
            <Border Background="{Binding Background}" Classes="row" Padding="10,7">
              <StackPanel Spacing="5">

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="{Binding ChoiceLabel}" FontSize="11"
                             Foreground="{DynamicResource FgDim}"
                             IsVisible="{Binding IsConflict}" />
                </StackPanel>

                <!-- 競合していないところは結果だけ出す -->
                <TextBlock Text="{Binding ResultText}" Classes="mono" FontSize="12"
                           TextWrapping="NoWrap"
                           IsVisible="{Binding !IsConflict}" />

                <!-- 競合は三者を並べて、選ばせる -->
                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding IsConflict}">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="左" FontSize="11" Foreground="{DynamicResource FgDim}" />
                    <Border Background="{DynamicResource CardBg}" CornerRadius="2" Padding="6,4">
                      <TextBlock Text="{Binding LeftText}" Classes="mono" FontSize="12"
                                 TextWrapping="NoWrap" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="右" FontSize="11" Foreground="{DynamicResource FgDim}" />
                    <Border Background="{DynamicResource CardBg}" CornerRadius="2" Padding="6,4">
                      <TextBlock Text="{Binding RightText}" Classes="mono" FontSize="12"
                                 TextWrapping="NoWrap" />
                    </Border>
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsConflict}">
                  <Button Content="左を採る" FontSize="11" Padding="10,3"
                          Command="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).TakeLeftCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="右を採る" FontSize="11" Padding="10,3"
                          Command="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).TakeRightCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="両方残す" FontSize="11" Padding="10,3"
                          Command="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).TakeBothCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="どちらも採らない" FontSize="11" Padding="10,3"
                          Command="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).TakeNeitherCommand}"
                          CommandParameter="{Binding}" />
                  <!--
                    **解決案は設定で明示的に許した人にだけ出る。**
                    説明や分類と違い、意味を取り違えると害になる生成なので。
                  -->
                  <Button Content="案を聞く" FontSize="11" Padding="10,3"
                          IsVisible="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).AssistAvailable}"
                          Command="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).AskAssistCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="解決案を出します。採るかどうかは自分で決めてください" />
                </StackPanel>

                <!--
                  届いた案。**平文で終わらせず、選べる形にして出す。**
                  他の選択肢と同じ行に「採る」を置くので、承認の粒度が
                  競合 1 つ単位になる。押さなければ何も起きない。
                -->
                <Border IsVisible="{Binding HasAssist}" Margin="0,6,0,0"
                        Background="{DynamicResource SubtleBg}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6">
                  <StackPanel Spacing="4">
                    <TextBlock Text="提案（人が確かめてから採ってください）"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgWarning}" />
                    <TextBlock Text="{Binding AssistText}" Classes="mono" FontSize="12"
                               TextWrapping="NoWrap" />
                    <Button Content="この案を採る" FontSize="11" Padding="10,3"
                            HorizontalAlignment="Left"
                            Command="{Binding $parent[UserControl].((vm:MergeViewModel)DataContext).TakeAssistCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 下の帯 -->
    <Border Grid.Row="2" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Text="{Binding DecisionText}" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource FgDim}" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FgWarning}"
                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
