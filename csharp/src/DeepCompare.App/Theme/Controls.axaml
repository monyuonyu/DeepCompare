<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    コントロールの見た目。FluentTheme の上に重ねる。

    **方針**: 影を使わず、面の明度差と細い境界線だけで階層を作る。影は
    明暗テーマの両方で自然に見せるのが難しく、たいてい片方が濁る。

    ボタンは 3 種類だけに絞る。
      既定（何も付けない）… ほとんどの操作
      Classes="accent"     … その画面で一番やりたいこと。1 画面に 1 つ
      Classes="quiet"      … 一覧の行に並ぶ小さな操作
    種類が増えると、押す側は「どれが強いのか」を毎回考えることになる。
  -->

  <!-- ボタン -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="{DynamicResource PadControl}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrong}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgNormal}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgPressed}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
  </Style>

  <!-- その画面で一番やりたいこと。1 画面に 1 つだけ -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentFg}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentFg}" />
  </Style>
  <!--
    **押せないときの見た目を必ず書く。**
    既定の無効化は背景を白にするが、accent の文字色（白）はそのまま残るので、
    白地に白文字で**ボタンが空に見えた。** 実際に画面で見つけた。
  -->
  <Style Selector="Button.accent:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgDisabled}" />
  </Style>

  <!-- 一覧の行に並ぶ小さな操作。枠を持たず、指したときだけ面が出る -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource PadTight}" />
    <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
  </Style>
  <Style Selector="Button.quiet /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgDim}" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgNormal}" />
  </Style>

  <!-- いま居る枝。**押せる見た目のままだと、どれが現在か分からない** -->
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
  </Style>

  <!-- 入力欄 -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBg}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="{DynamicResource PadControl}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
  </Style>

  <!-- 文字の役割。大きさではなく、太さと薄さで重要度を示す -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <!-- 面。カードと帯 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="{DynamicResource PadCard}" />
  </Style>

  <!-- 画面の上端の帯。下側にだけ境界線を引いて、本文と切る -->
  <Style Selector="Border.topbar">
    <Setter Property="Background" Value="{DynamicResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource PadBar}" />
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource StatusBarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,5" />
  </Style>

  <!-- 一覧の 1 行 -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>

  <!-- 縦の区切り。操作の群れを分ける -->
  <Style Selector="Border.vsep">
    <Setter Property="Background" Value="{DynamicResource Divider}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="4,2" />
  </Style>

  <!--
    アイコンだけのボタン。**説明はツールチップに逃がす。**
    画面に文字が並ぶほど、目が読む対象を探すのに時間がかかる。よく使う操作は
    形で覚えられるので、常時の文字は要らない。ただし**必ずツールチップを付ける**
    こと。形だけで意味が分かるアイコンは、実際にはほとんど無い。
  -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgPressed}" />
  </Style>

  <!-- 図形の描き方。輪郭線で描くので Fill は使わない -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource FgNormal}" />
    <!-- 24×24 の座標系なので、16 のときより少し太くしないと細く見える -->
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button.icon:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button:disabled Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource FgDisabled}" />
  </Style>
  <Style Selector="Path.icon.dim">
    <Setter Property="Stroke" Value="{DynamicResource FgDim}" />
  </Style>

  <!--
    絞り込みの切り替え。**押している状態が一目で分かること**が要点。
    Beyond Compare の All / Diffs / Same に当たる。
  -->
  <Style Selector="ToggleButton.filter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
  </Style>
  <Style Selector="ToggleButton.filter:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgNormal}" />
  </Style>
  <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.filter:checked Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.filter Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource FgDim}" />
  </Style>

  <!-- ツールチップ。すぐ出したい。既定は遅すぎて「効かない」と思われる -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource TooltipBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TooltipFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
  </Style>

  <!--
    畳んである所を示す帯。行 1 つ分の高さで、押すと開く。
    **控えめに出す。** ここは中身ではないので、本文より目立ってはいけない。
  -->
  <Style Selector="Button.foldband">
    <Setter Property="Background" Value="{DynamicResource BgUnimportant}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.foldband:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
  </Style>

  <!-- アウトラインの箱。Excel の [-] と同じ大きさ・同じ場所 -->
  <Style Selector="Button.outline">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="MinWidth" Value="11" />
    <Setter Property="MinHeight" Value="11" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrong}" />
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!--
    差分の塊を左右へ写す矢印。Beyond Compare の gutter button に当たる。
    **行の色と重ならない琥珀色にする。** 緑や赤の上に緑や赤の矢印を置くと、
    押せる場所として目に入らない。
  -->
  <Style Selector="Button.apply">
    <!--
      **押せる場所だと形で分かるようにする。** 線だけの矢印は、行の飾りと
      区別が付かない。薄い面と枠を持たせて、指したら塗りつぶす。
    -->
    <Setter Property="Background" Value="{DynamicResource ApplyArrowFill}" />
    <!-- 枠は淡く。濃い枠だと箱ばかりが目に入り、中の矢印が読みにくい -->
    <Setter Property="BorderBrush" Value="{DynamicResource ApplyArrowBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <!-- 矢印の周りに余白を取る。詰まっていると窮屈で、形も読み取りにくい -->
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Cursor" Value="Hand" />
    <!--
      **中身を箱の真ん中に置く。** 既定のままだと上に寄って見えた。
      矢印は横長の図形なので、縦の中心がずれると特に目立つ。
    -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.apply Path">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource ApplyArrow}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <!--
      **余白が偶数になる寸法にする。**
      箱 20×18、枠 1px なので内側は 18×16。中身を 12×12 にすると、
      余りは横 6・縦 4 でどちらも 2 で割り切れ、上下左右が揃う。
      11 にすると縦の余りが 5 になり、**片側へ 1 画素寄って上寄りに見えた。**
    -->
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button.apply:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ApplyArrowFillHover}" />
    <!-- 指したときだけ枠も濃くする。押せる場所だとはっきり分かる -->
    <Setter Property="BorderBrush" Value="{DynamicResource ApplyArrowHover}" />
  </Style>
  <!-- 指したら面を塗るので、矢印は抜き色にする -->
  <Style Selector="Button.apply:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource ApplyArrowOn}" />
  </Style>
  <Style Selector="Button.apply:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ApplyArrowHover}" />
  </Style>

  <!--
    起動画面に並べる「比較の種類」の大きな絵。
    Beyond Compare の Home view と同じ形。絵を大きく取り、名前を下に添える。
    ここに落とせばその種類で始められるので、押せる範囲は広く取る。
  -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Width" Value="132" />
    <Setter Property="Height" Value="112" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
  </Style>
  <Style Selector="Button.tile:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgPressed}" />
  </Style>
  <Style Selector="Button.tile Path.icon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <!-- 大きく出すので、線は相対的に細くする -->
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.tile:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- 左のサイドバー -->
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!--
    サイドバーの項目。押せる場所を広く取り、いま居る画面は面で示す。
    ListBox を土台にするのは、**排他であることが構造に出る**から。
    自前で「どれが選ばれているか」を持つと、必ずどこかでずれる。
  -->
  <Style Selector="ListBoxItem.nav">
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NavRoot"
                Background="Transparent"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="10,7">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem.nav:pointerover /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
  </Style>
  <Style Selector="ListBoxItem.nav:selected /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
  </Style>
  <Style Selector="ListBoxItem.nav:selected">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>
