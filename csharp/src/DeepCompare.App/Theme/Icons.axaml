<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    アイコン。すべて **24×24 の座標系**で描く。使う側は Stretch=Uniform で寸法を決める。

    16×16 から 24×24 へ広げたのは、細かい形を潰さずに描けるようにするため。
    16 だと 1 座標が 1/16 なので、角を丸めたり線を離したりする余裕が無く、
    どの形も似た「棒の集まり」になってしまう。

    **描く範囲は全アイコンで揃える（およそ 2〜22）。** Stretch=Uniform なので、
    範囲の狭い図形だけ引き伸ばされ、並べたときに 1 つだけ大きく見える。
    実際に Git のアイコンでこれを踏んだ。

    **書体の絵文字は使わない。** 環境によって出たり出なかったり、色が勝手に付いたり
    （絵文字は書体側の色を持つ）、幅が揃わなかったりする。実際、等幅書体すら
    解決できない環境があった。図形なら必ず同じ形で出て、色も指定どおりになる。

    形は輪郭線で描く（Stroke で使う）。塗りで描くと小さいときに潰れる。
    線幅は使う側で決める（既定 1.6）。
  -->

  <!-- ==== 比較の種類 ==== -->

  <!-- テキスト比較: 2 枚の紙。中の線で「本文」であることを示す -->
  <StreamGeometry x:Key="IconText">M3,3 h7 v18 h-7 z M14,3 h7 v18 h-7 z M5,7 h3 M5,10.5 h3 M5,14 h3 M16,7 h3 M16,10.5 h3 M16,14 h3</StreamGeometry>

  <!-- フォルダー比較: 見出し付きのフォルダー -->
  <StreamGeometry x:Key="IconFolder">M2.5,6 a1.5,1.5 0 0 1 1.5,-1.5 h5 l2,2.5 h9.5 a1.5,1.5 0 0 1 1.5,1.5 v10.5 a1.5,1.5 0 0 1 -1.5,1.5 h-16.5 a1.5,1.5 0 0 1 -1.5,-1.5 z</StreamGeometry>

  <!-- 構造比較: 木。節から枝が伸びる -->
  <StreamGeometry x:Key="IconStructure">M5,3.5 v15 M5,7.5 h5 M5,13 h5 M5,18.5 h5 M11.5,5.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M11.5,13 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M11.5,18.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M17,5.5 h4 M17,13 h4 M17,18.5 h4</StreamGeometry>

  <!-- 3 方向マージ: 2 本が 1 本に合わさる -->
  <StreamGeometry x:Key="IconMerge">M5,3 v4 c0,5 7,4 7,9 v5 M19,3 v4 c0,5 -7,4 -7,9 M9,17.5 l3,3.5 l3,-3.5</StreamGeometry>

  <!-- Git: 枝分かれと 3 つの節 -->
  <StreamGeometry x:Key="IconGit">M7,7 v10 M7,11 h7 a3,3 0 0 0 3,-3 M4.5,4.5 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0 M4.5,19.5 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0 M14.5,5.5 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0</StreamGeometry>

  <!-- 保存した比較: しおり -->
  <StreamGeometry x:Key="IconSaved">M6,3.5 h12 v17.5 l-6,-4.5 l-6,4.5 z</StreamGeometry>

  <!-- 起動画面へ戻る: 屋根と扉 -->
  <StreamGeometry x:Key="IconHome">M3,11 l9,-8 l9,8 M5.5,9.5 v11 h13 v-11 M10,20.5 v-6 h4 v6</StreamGeometry>

  <!-- ==== 操作 ==== -->

  <!-- 比較しなおす: 輪になった矢印 -->
  <StreamGeometry x:Key="IconRefresh">M20.5,12 a8.5,8.5 0 1 1 -2.9,-6.4 M21,3.5 v4.5 h-4.5</StreamGeometry>

  <!-- 前後の差分: 二重の山 -->
  <StreamGeometry x:Key="IconPrev">M6,13.5 l6,-6 l6,6 M6,19.5 l6,-6 l6,6</StreamGeometry>
  <StreamGeometry x:Key="IconNext">M6,10.5 l6,6 l6,-6 M6,4.5 l6,6 l6,-6</StreamGeometry>

  <!-- 検索: 虫眼鏡 -->
  <StreamGeometry x:Key="IconSearch">M10.5,3.5 a7,7 0 1 0 0,14 a7,7 0 1 0 0,-14 M15.6,15.6 l5.4,5.4</StreamGeometry>

  <!-- 取り消す / やり直す -->
  <StreamGeometry x:Key="IconUndo">M8.5,6 l-4.5,4.5 l4.5,4.5 M4,10.5 h11 a5,5 0 0 1 0,10 h-4</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M15.5,6 l4.5,4.5 l-4.5,4.5 M20,10.5 h-11 a5,5 0 0 0 0,10 h4</StreamGeometry>

  <!-- 保存: 下向きの矢印と受け皿 -->
  <StreamGeometry x:Key="IconSave">M12,3.5 v11 M7.5,10.5 l4.5,4.5 l4.5,-4.5 M4,19.5 h16</StreamGeometry>

  <!-- 書き出す: 箱から出ていく -->
  <StreamGeometry x:Key="IconExport">M12,15 v-12 M7.5,7 l4.5,-4 l4.5,4 M4,14 v6.5 h16 v-6.5</StreamGeometry>

  <!-- 設定: つまみの付いた 3 本のすべり -->
  <StreamGeometry x:Key="IconSettings">M3,6.5 h4 M11,6.5 h10 M3,12 h10 M17,12 h4 M3,17.5 h6 M13,17.5 h8 M7,4.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M13,10 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M9,15.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0</StreamGeometry>

  <!-- 左右を入れ替える -->
  <StreamGeometry x:Key="IconSwap">M3.5,8.5 h15 M15,5 l3.5,3.5 l-3.5,3.5 M20.5,15.5 h-15 M9,12 l-3.5,3.5 l3.5,3.5</StreamGeometry>

  <!-- 明るい / 暗い -->
  <StreamGeometry x:Key="IconSun">M12,7 a5,5 0 1 0 0,10 a5,5 0 1 0 0,-10 M12,1.5 v2.5 M12,20 v2.5 M1.5,12 h2.5 M20,12 h2.5 M4.2,4.2 l1.8,1.8 M18,18 l1.8,1.8 M19.8,4.2 l-1.8,1.8 M6,18 l-1.8,1.8</StreamGeometry>
  <StreamGeometry x:Key="IconMoon">M20.5,15.5 a9,9 0 1 1 -12,-12 a7,7 0 0 0 12,12 z</StreamGeometry>

  <!-- 表示の絞り込み -->
  <StreamGeometry x:Key="IconFilterAll">M3.5,6 h17 M3.5,12 h17 M3.5,18 h17</StreamGeometry>
  <!-- 「差異のあるもの」は上下に離れた 2 本と、間の短い線 -->
  <StreamGeometry x:Key="IconFilterDiff">M3.5,5.5 h17 M3.5,18.5 h17 M7,12 h10</StreamGeometry>
  <!--
    「同じもの」は等号で表す。**1 本線にしない。**
    高さを持たない図形は Stretch=Uniform で潰れ、点にしか見えなくなる。
  -->
  <StreamGeometry x:Key="IconFilterSame">M4,9 h16 M4,15 h16</StreamGeometry>

  <!-- 空白を見せる: 中点とタブの矢印 -->
  <StreamGeometry x:Key="IconWhitespace">M5,12 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0 M11,12 h7 M15.5,8.5 l3.5,3.5 l-3.5,3.5 M4,5 h16 M4,19 h16</StreamGeometry>

  <!-- 木の開閉 -->
  <StreamGeometry x:Key="IconChevronRight">M9.5,5 l7,7 l-7,7</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M5,9.5 l7,7 l7,-7</StreamGeometry>

  <!-- 全部開く / 全部閉じる -->
  <StreamGeometry x:Key="IconExpand">M12,3.5 v17 M7,8.5 l5,-5 l5,5 M7,15.5 l5,5 l5,-5</StreamGeometry>
  <StreamGeometry x:Key="IconCollapse">M6,4.5 l6,6 l6,-6 M6,19.5 l6,-6 l6,6</StreamGeometry>

  <!-- 差分を反映する向き -->
  <StreamGeometry x:Key="IconToRight">M4,12 h15 M14,7 l5,5 l-5,5</StreamGeometry>
  <StreamGeometry x:Key="IconToLeft">M20,12 h-15 M10,7 l-5,5 l5,5</StreamGeometry>

  <!-- 参照（フォルダーを開く） -->
  <StreamGeometry x:Key="IconBrowse">M2.5,7.5 a1.5,1.5 0 0 1 1.5,-1.5 h5 l2,2.5 h9.5 a1.5,1.5 0 0 1 1.5,1.5 v7.5 a1.5,1.5 0 0 1 -1.5,1.5 h-16.5 a1.5,1.5 0 0 1 -1.5,-1.5 z M2.5,11.5 h19</StreamGeometry>

  <!-- 索引へ載せる / 降ろす -->
  <StreamGeometry x:Key="IconStage">M12,19 v-13 M7,11 l5,-5 l5,5 M4,3.5 h16</StreamGeometry>
  <StreamGeometry x:Key="IconUnstage">M12,5 v13 M7,13 l5,5 l5,-5 M4,20.5 h16</StreamGeometry>

  <!-- 開く（別の場所で詳しく見る） -->
  <StreamGeometry x:Key="IconOpen">M10,4.5 h-5.5 v15 h15 v-5.5 M14.5,3.5 h6 v6 M20.5,3.5 l-9,9</StreamGeometry>

  <!-- 閉じる -->
  <StreamGeometry x:Key="IconClose">M6,6 l12,12 M18,6 l-12,12</StreamGeometry>

  <!-- 新しいタブ -->
  <StreamGeometry x:Key="IconPlus">M12,4.5 v15 M4.5,12 h15</StreamGeometry>

</ResourceDictionary>
