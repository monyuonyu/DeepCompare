<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeepCompare.App"
        xmlns:views="clr-namespace:DeepCompare.App.Views"
        x:Class="DeepCompare.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="DeepCompare"
        Width="1280" Height="820"
        MinWidth="860" MinHeight="480"
        Background="{DynamicResource WindowBg}"
        DragDrop.AllowDrop="True">

  <Window.DataTemplates>
    <!-- 出す画面は今の状態の型で決まる。切り替えのための分岐をコード側に持たない。 -->
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:FolderCompareViewModel">
      <views:FolderCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:TextCompareViewModel">
      <views:TextCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:StructuredCompareViewModel">
      <views:StructuredCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:GitViewModel">
      <views:GitView />
    </DataTemplate>
    <DataTemplate DataType="vm:MergeViewModel">
      <views:MergeView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="Auto,*">

    <!--
      左のサイドバー。**「戻る」の往復をやめる。**
      比較の種類が 5 つに増えると、種類を変えるたびに一度戻る必要があり手数が増える。
      加えて戻ると状態が捨てられ、比較のやり直しになっていた。
    -->
    <Border Grid.Column="0" Classes="sidebar" Width="164">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10" Spacing="1">
          <TextBlock Text="DeepCompare" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="意味で行を対応付ける" Classes="hint" />
        </StackPanel>

        <!-- 下端: テーマの切り替え。アイコンだけ -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0" Padding="10,8">
          <Button Classes="icon" HorizontalAlignment="Left"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="{Binding ThemeTooltip}">
            <Path Classes="icon" Data="{Binding ThemeIcon}" />
          </Button>
        </Border>

        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,4">
          <ListBox.Styles>
            <!--
              Classes は Setter で付けられない（AvaloniaProperty ではない）ので、
              nav の見た目をここで直接当てる。持ち場は Controls.axaml の
              ListBoxItem.nav と揃えてある。
            -->
            <Style Selector="ListBoxItem">
              <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="6,1" />
              <Setter Property="Template">
                <ControlTemplate>
                  <Border Name="NavRoot" Background="Transparent"
                          CornerRadius="{DynamicResource RadiusMedium}" Padding="10,7">
                    <!--
                      **ContentTemplate を渡すこと。** 渡さないと ItemTemplate が
                      使われず、項目が ToString() の結果（型名）で出る。
                    -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ Border#NavRoot">
              <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ Border#NavRoot">
              <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Foreground" Value="{DynamicResource Accent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="ListBoxItem:selected Path.icon">
              <Setter Property="Stroke" Value="{DynamicResource Accent}" />
            </Style>
            <Style Selector="ListBoxItem Path.icon">
              <Setter Property="Stroke" Value="{DynamicResource FgDim}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="10"
                          ToolTip.Tip="{Binding Hint}">
                <Path Classes="icon" Data="{Binding Icon}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding Current}" />
  </Grid>
</Window>
