<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NativeAOT で発行するので、非対応の書き方を早い段階で弾く。 -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Shift_JIS / EUC-JP を扱うために CodePagesEncodingProvider を登録しているが、
    .NET 10 では System.Text.Encoding.CodePages が本体に含まれるため、
    パッケージ参照は不要（付けると NU1510 で弾かれる）。
  -->

  <ItemGroup>
    <!-- 行列積の内側で使う SIMD 化された内積など。純粋なマネージドコードなので
         NativeAOT でも実行ファイルに畳み込まれ、別ファイルにならない。 -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 正規化・記号判定といった内部の段は、単体で試験できないと
         「埋め込みが合わない」までしか分からず原因を切り分けられない。 -->
    <InternalsVisibleTo Include="DeepCompare.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      重み（22MB）は exe に埋め込まず、隣に置く。埋め込みをやめた理由は 3 つ:
      exe が 46MB → 24MB に減る、起動時の 22MB 読み出しがメモリマップで省ける、
      そして再ビルド無しでモデルを差し替えられる（日本語モデルの検討に効く）。

      リポジトリ直下の assets/ を直に参照する。ここへ複製すると同じ 22MB が
      2 箇所に居座り、片方だけ更新される事故の元になる。

      Content なので、この Engine を参照するプロジェクト（App・試験）の
      出力先にも運ばれる。
    -->
    <!--
      **配布物にモデルを含めない（2026-08-14）。**
      `CopyToPublishDirectory="Never"` がその指定。開発と試験の出力先には
      運ぶので、埋め込みを使う試験はこれまでどおり動く。

      日本語で使うには多言語モデルが要るが、日英に絞って刈り込んでも 59MB、
      刈り込まなければ 114MB ある。**114MB は GitHub が push を拒む大きさ**
      （100MiB 超）で、履歴に入れるなら Git LFS か Releases の仕組みが要る。
      英語モデルだけ配っても、日本語では「バグ」と「ハク」を同一と見るので、
      日本語の利用者には無意味な 22MB になる。

      **モデルが無くても道具は成立する。** 行の対応付けは Myers に落ち、
      2000 行で 20ms。普通の diff と同じ答えが出る。意味的な対応付けが
      要る人だけがモデルを置く。
    -->
    <Content Include="$(MSBuildThisFileDirectory)../../assets/minilm.dcm" Link="minilm.dcm"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />

    <!--
      **取ってきてあれば配布物に入れる。** `tools/fetch-model.sh` が
      Releases から落として assets/ へ置く。git には入れていないので、
      clone しただけの状態では**存在しない**——そのときは何も含めずに
      ビルドが通る（モデル無しでも Myers で動く）。

      Exists() を条件にしているのはそのため。無条件に Include すると、
      取っていない人のビルドが「ファイルが無い」で壊れる。
    -->
    <Content Include="$(MSBuildThisFileDirectory)../../assets/multilingual-ja.dcm"
             Link="multilingual-ja.dcm"
             Condition="Exists('$(MSBuildThisFileDirectory)../../assets/multilingual-ja.dcm')"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)../../assets/multilingual-ja.vocab"
             Link="multilingual-ja.vocab"
             Condition="Exists('$(MSBuildThisFileDirectory)../../assets/multilingual-ja.vocab')"
             CopyToOutputDirectory="PreserveNewest" />

    <!-- 語彙は 466KB と小さく、分かち書きの実装と対でしか意味を持たないので
         埋め込んだままにする。重みと違って差し替える理由がない。 -->
    <EmbeddedResource Include="Assets/vocab.txt" LogicalName="vocab.txt" />
  </ItemGroup>

</Project>
