<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>deepcompare</AssemblyName>

    <!-- ランタイム不要のネイティブ実行ファイルにする。起動が 10ms 台で済むのは
         これのおかげで、単一 exe であることとは別の話。 -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>

    <!--
      AOT の既定は保守的な命令セット（SSE2 相当）を狙うので、埋め込み推論の内積が
      AVX2 を使えず遅くなる。実測で 2000 行 5% 変更の比較が 3.9 秒 → 2.2 秒（1.8 倍）。
      比較時間はほぼ全部が埋め込み推論なので、ここが直に効く。

      x86-64-v3 は AVX2/FMA を要求する。対象は Haswell（2013 年）以降で、
      それより古い CPU では動かない。より広く配るなら x86-64-v2 に落とすが、
      浮動小数の演算幅が半分になるぶん遅くなる。
    -->
    <IlcInstructionSet Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'linux-x64'">x86-64-v3</IlcInstructionSet>
  </PropertyGroup>

  <ItemGroup>
    <!--
      画面の試験から、押した結果を **待てる** ようにするため。
      コマンドは ICommand なので Execute は async void で、外からは
      終わりが分からない。中身の Task を internal で見せて await する。
    -->
    <InternalsVisibleTo Include="DeepCompare.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- NativeAOT で XAML を扱うために必要。 -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DeepCompare.Engine/DeepCompare.Engine.csproj" />
    <!--
      LLM 支援。**App だけが両方を知る。** Engine は Assist を参照しないので、
      比較の経路に通信が紛れ込む余地が構造として無い。
    -->
    <ProjectReference Include="../DeepCompare.Assist/DeepCompare.Assist.csproj" />
  </ItemGroup>

</Project>
