<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             xmlns:views="clr-namespace:DeepCompare.App.Views"
             x:Class="DeepCompare.App.Views.TextCompareView"
             x:DataType="vm:TextCompareViewModel">

  <!--
    キーボード操作。**手がキーボードから離れないようにする。**
    Ctrl+F で検索欄へ、F3 で次、Shift+F3 で前、Ctrl+H で置換欄へ。
    Beyond Compare や一般的な編集器と同じ割り当てにする。
  -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding OpenReplaceCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
    <!--
      **選んだ行をまとめて扱う。** これまでは 1 行ずつしか直せず、
      「全部選んで消す」「全部選んで貼り替える」ができなかった。
      Delete / BackSpace で消し、Ctrl+V で置き換える。
      効く先は最後に押した側（左右）。
    -->
    <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGoToCommand}" />
    <!--
      自分が直した場所へ飛ぶ。**差分の移動とは別の鍵にする。**
      差分は「相手と違う所」、こちらは「自分が触った所」。
    -->
    <KeyBinding Gesture="Ctrl+Alt+Down" Command="{Binding NextEditCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+Up" Command="{Binding PreviousEditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Gesture="Back" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteOverSelectionCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding CompareCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveLeftCommand}" />
    <KeyBinding Gesture="Alt+Down" Command="{Binding NextDifferenceCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding PreviousDifferenceCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- 行の高さを固定する。仮想化は「n 行目は n * 高さ の位置」で成り立つ。 -->
    <Style Selector="TextBlock.cell">
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono,MS Gothic,monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!--
      行の中に置く入力欄。**行の高さを崩さない**ことが要点。
      高さが変わると、仮想化の「n 行目は n × 高さ」という前提が壊れる。
    -->
    <Style Selector="TextBox.inline">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <!--
        **行の色を塗り潰さない。** 入力欄の地の色を敷いていたので、
        選んだ行だけ差分の色が消え、環境によっては文字まで見えなく
        なっていた（キーボードで上下に動かすと、動いた先が次々に
        真っ白になる）。地は行に任せ、文字色だけ明示する。
      -->
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
      <Setter Property="CaretBrush" Value="{DynamicResource FgNormal}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.inline /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 指しても押しても、地は行のまま -->
    <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.gutter">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Width" Value="52" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!--
      上端。**アイコン 1 段＋パス 1 段に畳んだ。**
      以前は 4 段あり、画面の高さの 1/4 を操作が占めていた。よく使うものだけを
      形で出し、説明はツールチップへ、細かい設定は歯車の中へ逃がす。
      Beyond Compare も操作はアイコン 1 段で、その下がパス行になっている。
    -->
    <StackPanel DockPanel.Dock="Top">

      <Border Classes="topbar" BorderThickness="0">
        <StackPanel Orientation="Horizontal" Spacing="2">

          <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
                  ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
            <Path Classes="icon" Data="{StaticResource IconHome}" />
          </Button>
          <Border Classes="vsep" />

          <Button Classes="icon" Command="{Binding CompareCommand}"
                  IsEnabled="{Binding !IsBusy}" ToolTip.Tip="比較する">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" />
          </Button>

          <Border Classes="vsep" />

          <Button Classes="icon" Command="{Binding PreviousDifferenceCommand}"
                  ToolTip.Tip="前の差分へ">
            <Path Classes="icon" Data="{StaticResource IconPrev}" />
          </Button>
          <Button Classes="icon" Command="{Binding NextDifferenceCommand}"
                  ToolTip.Tip="次の差分へ">
            <Path Classes="icon" Data="{StaticResource IconNext}" />
          </Button>

          <!-- 差分だけに絞る。押している状態が面で分かる -->
          <ToggleButton Classes="filter" IsChecked="{Binding ChangesOnly}"
                        ToolTip.Tip="変更のある行だけを出す">
            <Path Classes="icon" Data="{StaticResource IconFilterDiff}" />
          </ToggleButton>
          <!--
            上下に並べる（BC の over-under layout）。
            **横に長い行のときに効く。** 左右だと 1 行の幅が半分になる。
          -->
          <ToggleButton Classes="filter" IsChecked="{Binding OverUnder}"
                        ToolTip.Tip="上下に並べる（横に長い行を読むとき）">
            <Path Classes="icon" Data="{StaticResource IconOverUnder}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding ShowWhitespace}"
                        ToolTip.Tip="空白・タブを記号で見せる">
            <Path Classes="icon" Data="{StaticResource IconWhitespace}" />
          </ToggleButton>
          <!--
            長い行の折り返し。**既定は折り返さない** — 1 行が何行にも
            見えると、左右を数えて見比べるときに数が合わなくなる。
          -->
          <ToggleButton Classes="filter" IsChecked="{Binding WordWrap}"
                        ToolTip.Tip="長い行を折り返す">
            <Path Classes="icon" Data="{StaticResource IconWordWrap}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding FullEdit}"
                        ToolTip.Tip="本文の中で直接直す（選んだ行が入力欄になります）">
            <Path Classes="icon" Data="{StaticResource IconEdit}" />
          </ToggleButton>

          <Border Classes="vsep" />

          <Button Classes="icon" Command="{Binding UndoCommand}"
                  ToolTip.Tip="反映を取り消す。保存した後でも遡れる">
            <Path Classes="icon" Data="{StaticResource IconUndo}" />
          </Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="やり直す">
            <Path Classes="icon" Data="{StaticResource IconRedo}" />
          </Button>

          <Border Classes="vsep" />

          <!-- 保存は 1 つに畳む。左右の矢印は「反映の向き」で使うので、
               同じ形を保存に流用すると意味がぶつかる -->
          <Button Classes="icon" ToolTip.Tip="保存する">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="左のファイルを保存" Command="{Binding SaveLeftCommand}" />
                <MenuItem Header="右のファイルを保存" Command="{Binding SaveRightCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconSave}" />
          </Button>

          <!-- 未保存があることは、点だけで足りる -->
          <Ellipse Width="7" Height="7" Fill="{DynamicResource FgInline}"
                   VerticalAlignment="Center" Margin="2,0"
                   IsVisible="{Binding HasUnsavedChanges}"
                   ToolTip.Tip="保存していない変更があります" />

          <Border Classes="vsep" />

          <Button Classes="icon" ToolTip.Tip="差分を書き出す">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="unified 形式（patch で適用できる）"
                          Command="{Binding ExportUnifiedCommand}" />
                <!--
                  **保存せずに見る。** 貼り付けて誰かに渡す、レビューに
                  引用する、といった場面では、ファイルにする手間が邪魔。
                -->
                <MenuItem Header="patch をその場で見る"
                          Command="{Binding ShowPatchCommand}" />
                <MenuItem Header="HTML（左右を並べた表）"
                          Command="{Binding ExportHtmlCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconExport}" />
          </Button>

          <Border Classes="vsep" />

          <!--
            検索は**ボタン 1 つ**にする。欄をツールバーに並べると、使って
            いないときも幅を取り、他の操作が押し出される（実際そうなっていた）。
            押すか Ctrl+F で枠が開き、Esc で閉じる。
          -->
          <ToggleButton Classes="filter" IsChecked="{Binding IsSearchOpen}"
                        ToolTip.Tip="検索と置換（Ctrl+F / Ctrl+H）">
            <Path Classes="icon" Data="{StaticResource IconSearch}" />
          </ToggleButton>

          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                       Width="70" VerticalAlignment="Center" Margin="6,0" />

          <!--
            細かい設定は歯車の中へ。**毎回は触らないが、無いと困るもの**の置き場。
            常時出していると、よく使う操作を探す邪魔になる。
          -->
          <Button Classes="icon" Command="{Binding CompareClipboardCommand}"
                  ToolTip.Tip="左のファイルとクリップボードの中身を比べる">
            <Path Classes="icon" Data="{StaticResource IconClipboard}" />
          </Button>

          <Button Classes="icon" HorizontalAlignment="Right" ToolTip.Tip="比較の設定">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="330" Spacing="14" Margin="4">

                  <StackPanel Spacing="6">
                    <TextBlock Text="重要でない差分" Classes="title" />
                    <TextBlock Classes="hint"
                               Text="ここで指定した違いは対応付けの段階から無視されるので、表示だけでなく行の並びそのものが変わります。" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="空白" VerticalAlignment="Center"
                                 Margin="0,0,10,6" />
                      <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding WhitespaceModeIndex}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <ComboBoxItem Content="そのまま" />
                        <ComboBoxItem Content="行末のみ" />
                        <ComboBoxItem Content="行頭と行末" />
                        <ComboBoxItem Content="連続空白を 1 つ" />
                        <ComboBoxItem Content="すべて" />
                      </ComboBox>
                      <CheckBox Grid.Row="1" Grid.Column="1" Content="大文字小文字を区別しない"
                                IsChecked="{Binding IgnoreCase}" />
                    </Grid>
                    <TextBlock Text="無視する正規表現（1 行に 1 つ）" Classes="hint" />
                    <TextBox Text="{Binding IgnoredPatterns}" Height="54" AcceptsReturn="True"
                             FontSize="11" PlaceholderText="\d{4}-\d{2}-\d{2}" />
                    <TextBlock Text="{Binding ImportanceError}"
                               Foreground="{DynamicResource FgWarning}"
                               TextWrapping="Wrap" FontSize="11" />
                    <Button Content="適用して比べ直す" Classes="accent"
                            HorizontalAlignment="Left"
                            Command="{Binding ApplyImportanceCommand}" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="対応とみなす類似度" Classes="title" />
                    <TextBlock Classes="hint"
                               Text="これを下回る行同士は、対にせず削除と追加として別々に並べます。短いコード行は似ていても値が伸びにくいので、対応が取れないときは下げてください。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Slider Value="{Binding PairThreshold}" Minimum="0" Maximum="0.95"
                              Width="220" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding PairThreshold, StringFormat={}{0:F2}}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="差分の前後に残す行" Classes="title" />
                    <TextBlock Classes="hint" Text="「変更のある行だけ」のときに、前後を何行残すか。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Slider Value="{Binding ContextLines}" Minimum="0" Maximum="10"
                              Width="220" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ContextLines, StringFormat={}{0:F0}}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="検索のしかた" Classes="title" />
                    <CheckBox Content="正規表現として扱う" IsChecked="{Binding SearchUseRegex}" />
                    <CheckBox Content="大文字小文字を区別する" IsChecked="{Binding SearchMatchCase}" />
                    <CheckBox Content="単語として一致するものだけ" IsChecked="{Binding SearchWholeWord}" />
                    <CheckBox Content="端まで来たら反対側から続ける" IsChecked="{Binding SearchWrap}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="探す側" VerticalAlignment="Center" />
                      <ComboBox SelectedIndex="{Binding SearchSide}" Width="130">
                        <ComboBoxItem Content="両方" />
                        <ComboBoxItem Content="左だけ" />
                        <ComboBoxItem Content="右だけ" />
                      </ComboBox>
                    </StackPanel>
                  </StackPanel>

                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconSettings}" />
          </Button>

        </StackPanel>
      </Border>

      <!-- パスの行。左右で対になるので、同じ幅で並べる -->
      <Border Classes="topbar">
        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <TextBox Text="{Binding LeftPath}" HorizontalAlignment="Stretch" Width="NaN"
                     PlaceholderText="左のファイル" />
            <Button Classes="icon" Command="{Binding BrowseLeftCommand}" ToolTip.Tip="左のファイルを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconBrowse}" />
            </Button>
          </StackPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Text="↔" Classes="dim"
                     VerticalAlignment="Center" Margin="10,0" />

          <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <TextBox Text="{Binding RightPath}" HorizontalAlignment="Stretch" Width="NaN"
                     PlaceholderText="右のファイル" />
            <Button Classes="icon" Command="{Binding BrowseRightCommand}" ToolTip.Tip="右のファイルを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconBrowse}" />
            </Button>
          </StackPanel>

          <!--
            ファイルそのものの情報。**パスのすぐ下に置く。**
            「どちらが新しいか」「大きさが違うか」は、中身を読む前に
            知りたいことで、状態バーまで目を動かす話ではない。
          -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LeftFileInfo}"
                     FontSize="11" Margin="4,3,0,0"
                     Foreground="{DynamicResource FgDim}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RightFileInfo}"
                     FontSize="11" Margin="4,3,0,0"
                     Foreground="{DynamicResource FgDim}"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

    </StackPanel>

    <!--
      選んだ行を全幅で出し、**その場で直せる**（BC の Text Details）。
      本文の側を編集できるようにすると、仮想化した一覧の中に入力欄を置くことに
      なり、行の高さと選択の扱いが一気に難しくなる。BC も同じ理由でここに置く。
      横に長い行を折り返さずに読めるという利点もある。
    -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
            Padding="6,2" IsVisible="{Binding ShowDetails}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

        <!--
          **見出しの行をやめた。** 「左 1 行目 / 右 1 行目」と書いていたが、
          上が左・下が右であることは並びで分かるし、その 2 行ぶんの高さは
          本文から削られていた。行番号は左の欄の中に薄く出す。

          切り替えのボタンは右端へ。**読む物の上ではなく、脇に置く。**
        -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                    Orientation="Horizontal" Spacing="1" Margin="6,0,0,0"
                    VerticalAlignment="Center">
          <Button Classes="icon small" ToolTip.Tip="この帯を閉じる"
                  Command="{Binding HideDetailsCommand}">
            <Path Classes="icon" Data="{StaticResource IconClose}" />
          </Button>
          <!--
            文字の対応で見る（BC の Alignment Details）。
            **色だけでは、片方にしか無い文字があると桁がずれて読めない。**
          -->
          <ToggleButton Classes="filter" IsChecked="{Binding DetailAsAlignment}"
                        Padding="4" MinHeight="0"
                        ToolTip.Tip="左右の文字の対応を、桁を揃えて見る">
            <Path Classes="icon" Data="{StaticResource IconAlignment}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding DetailAsHex}"
                        Padding="4,2" MinHeight="0"
                        ToolTip.Tip="バイトで見る（空白でも分からないときの最後の拠り所）">
            <TextBlock Text="16" FontSize="9" />
          </ToggleButton>
        </StackPanel>

        <!--
          文字で見る（直せる）。
          **打った内容は欄を離れた時点で本文へ入る。** 「直す」ボタンを
          押させていたが、押し忘れると黙って消える。
        -->
        <TextBox Grid.Row="0" Grid.Column="0"
                 Text="{Binding DetailLeft, UpdateSourceTrigger=LostFocus}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="13"
                 IsEnabled="{Binding CanEditLeftDetail}"
                 IsVisible="{Binding DetailShowsText}"
                 Watermark="{Binding DetailLeftLabel}"
                 MinHeight="0" Padding="5,1"
                 AcceptsReturn="False" Margin="0,0,0,1" />

        <TextBox Grid.Row="1" Grid.Column="0"
                 Text="{Binding DetailRight, UpdateSourceTrigger=LostFocus}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="13"
                 IsEnabled="{Binding CanEditRightDetail}"
                 IsVisible="{Binding DetailShowsText}"
                 Watermark="{Binding DetailRightLabel}"
                 MinHeight="0" Padding="5,1"
                 AcceptsReturn="False" />

        <!-- バイトで見る（読むだけ。ここから直すのは危ないので許さない） -->
        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding DetailLeftHex}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 IsReadOnly="True" IsVisible="{Binding DetailAsHex}" Margin="0,0,0,3" />
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DetailRightHex}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 IsReadOnly="True" IsVisible="{Binding DetailAsHex}" />

        <!--
          文字の対応（BC の Alignment Details）。
          **1 つの欄に左右をまたいで出す。** 桁を揃えて見せるのが目的。
        -->
        <TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                 Text="{Binding DetailAlignment}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 IsReadOnly="True" IsVisible="{Binding DetailAsAlignment}"
                 AcceptsReturn="True" />

      </Grid>
    </Border>

    <!--
      **符号化と改行は左右それぞれの側に置く。** 全部を横一列に並べていたので、
      「左: UTF-8 / LF    右: UTF-8 / LF」のどちらの話か文字を追う必要があった。
      押すと選び直せる（推定が外れたときの逃げ道）。
    -->
    <!--
      状態バー。**1 本にまとめ、区画で分ける。**

      符号化の行と統計の行で 2 段を使っていたが、そのぶん本文が減る。
      Beyond Compare は 1 本の帯を縦線で区切り、意味の違う情報を
      並べている。同じ形にする。

      左から: 差分の数 → 中身の内訳 → 左右の読み方 → 開き口。
    -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar"
            IsVisible="{Binding !ShowPlaceholder}">
      <DockPanel LastChildFill="False">

        <!-- 差分の数。**最初に目に入る場所に置く。** ここが 0 なら中身は同じ -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="5"
                    VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource IconFilterDiff}"
                Width="11" Height="11" VerticalAlignment="Center"
                Stroke="{DynamicResource FgDim}" StrokeThickness="1.6" />
          <TextBlock Text="{Binding DiffCountText}" FontSize="11"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Border DockPanel.Dock="Left" Classes="vsep" Margin="10,3" />

        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource FgDim}" />

        <!--
          「同じに見えるのに一致しない」の原因を、聞かれる前に出す。
        -->
        <Border DockPanel.Dock="Left" Classes="vsep" Margin="10,3"
                IsVisible="{Binding HasInvisibleWarning}" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding InvisibleWarning}" FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource FgWarning}"
                   IsVisible="{Binding HasInvisibleWarning}" />

        <!--
          手で付けた対応があることは**必ず見える場所に出す。**
          自動の結果だと思って読まれると、なぜそう並ぶのか分からなくなる。
        -->
        <Border DockPanel.Dock="Left" Classes="vsep" Margin="10,3"
                IsVisible="{Binding ManualNote,
                  Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding ManualNote}" FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Accent}"
                   IsVisible="{Binding ManualNote,
                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!--
          **閉じているときの開き口。** 帯を閉じたあと、どこから出せばいいのか
          分からなくなるのを避ける。
        -->
        <Button DockPanel.Dock="Right" Classes="icon small" Margin="6,0,0,0"
                IsVisible="{Binding !ShowDetails}"
                Command="{Binding ShowDetailsCommand}"
                ToolTip.Tip="選んだ行を下に出す（そこで直せます）">
          <Path Classes="icon" Data="{StaticResource IconDetails}" />
        </Button>

        <!-- 読み方。**左右それぞれ選び直せる**（推定が外れたときの逃げ道） -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5"
                    VerticalAlignment="Center">
          <TextBlock Text="右" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgDim}" />
          <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding RightEncoding}"
                    DisplayMemberBinding="{Binding Label}"
                    FontSize="11" Padding="6,0" MinHeight="0"
                    ToolTip.Tip="読み方が違うと思ったら選び直す（読み直します）" />
          <TextBlock Text="{Binding RightEnding}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgDim}" />
        </StackPanel>

        <Border DockPanel.Dock="Right" Classes="vsep" Margin="10,3" />

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5"
                    VerticalAlignment="Center">
          <TextBlock Text="左" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgDim}" />
          <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding LeftEncoding}"
                    DisplayMemberBinding="{Binding Label}"
                    FontSize="11" Padding="6,0" MinHeight="0"
                    ToolTip.Tip="読み方が違うと思ったら選び直す（読み直します）" />
          <TextBlock Text="{Binding LeftEnding}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgDim}" />
        </StackPanel>

      </DockPanel>
    </Border>

    <!--
      **意味的な対応付けが効いていないことを黙らない。**
      この道具の売りなので、効いていないと思われずに使われるのが一番困る。

      **状態バーの中に入れない。** あそこは横並びなので幅が無限に取れ、
      TextWrapping が効かずに右端で切れる。長い文は自分の行を持たせる。
    -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar"
            IsVisible="{Binding HasModelWarning}">
      <TextBlock Text="{Binding ModelWarning}" FontSize="11"
                 Foreground="{DynamicResource FgWarning}" TextWrapping="Wrap" />
    </Border>

    <!--
      右端に差分の地図。全体のどこに差分があるかを示し、押すとそこへ飛ぶ。
      差分ビューは画面に入る 40 行ほどしか見せないので、これが無いと
      2000 行のファイルで今どこに居るのかが掴めない。
    -->
    <vm:DiffMap DockPanel.Dock="Left"
                Rows="{Binding VisibleRows}"
                ViewStart="{Binding MapViewStart}"
                ViewSize="{Binding MapViewSize}"
                ClickedPosition="{Binding MapClicked, Mode=TwoWay}"
                CurrentLine="{Binding SelectedRowIndex}"
                IsVisible="{Binding !ShowPlaceholder}"
                ToolTip.Tip="差分の位置。押すか、押したままなぞると、そこへ移ります" />

    <Panel>
      <TextBlock Text="{Binding Placeholder}" IsVisible="{Binding ShowPlaceholder}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" />

      <!--
        検索と置換。**本文の上に浮かせる**（VS Code と同じ）。
        本文の幅を削らないので、探しながら読める。
        左端の折り返しボタンで置換の行を開く。
      -->
      <!--
        行番号で飛ぶ枠。**検索と同じ場所に出す。** 出る場所が同じなら、
        どちらを開いたかは中身を見れば分かる。
      -->
      <Border Classes="findbox" IsVisible="{Binding IsGoToOpen}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,6,24,0" ZIndex="11">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="行" VerticalAlignment="Center" FontSize="12" />
          <TextBox Text="{Binding GoToLine}" Width="90" MinHeight="0" Padding="6,3">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding GoToCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Classes="icon small" Command="{Binding GoToCommand}" ToolTip.Tip="飛ぶ">
            <Path Classes="icon" Data="{StaticResource IconCheck}" />
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="findbox" IsVisible="{Binding IsSearchOpen}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,6,18,0" ZIndex="10">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

          <!-- 置換の行を開く折り返し。**畳んであることが形で分かる。** -->
          <ToggleButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        Classes="chevron" IsChecked="{Binding IsReplaceOpen}"
                        VerticalAlignment="Top" Margin="0,4,2,0"
                        ToolTip.Tip="置換を開く（Ctrl+H）">
            <Panel>
              <Path Classes="icon" Width="10" Height="10"
                    IsVisible="{Binding !IsReplaceOpen}"
                    Data="{StaticResource IconChevronRight}" />
              <Path Classes="icon" Width="10" Height="10"
                    IsVisible="{Binding IsReplaceOpen}"
                    Data="{StaticResource IconChevronDown}" />
            </Panel>
          </ToggleButton>

          <!-- 検索の行 -->
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <TextBox Name="SearchBox" Text="{Binding SearchText}" Width="190" Height="26"
                     PlaceholderText="検索" VerticalContentAlignment="Center" />
            <TextBlock Text="{Binding SearchStatus}" Classes="hint"
                       VerticalAlignment="Center" Margin="4,0" MinWidth="52" />
            <Button Classes="icon small" Command="{Binding FindPreviousCommand}"
                    ToolTip.Tip="前を探す（Shift+F3）">
              <Path Classes="icon" Data="{StaticResource IconPrev}" />
            </Button>
            <Button Classes="icon small" Command="{Binding FindNextCommand}"
                    ToolTip.Tip="次を探す（F3）">
              <Path Classes="icon" Data="{StaticResource IconNext}" />
            </Button>
            <Button Classes="icon small" Command="{Binding CloseSearchCommand}"
                    ToolTip.Tip="閉じる（Esc）">
              <Path Classes="icon" Data="{StaticResource IconClose}" />
            </Button>
          </StackPanel>

          <!-- 置換の行。畳んであるときは出ない -->
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2"
                      Margin="0,3,0,0" IsVisible="{Binding IsReplaceOpen}">
            <TextBox Text="{Binding ReplaceText}" Width="190" Height="26"
                     PlaceholderText="置き換える文字列" VerticalContentAlignment="Center" />
            <Button Content="全部" FontSize="11" Padding="8,2" Height="26"
                    Command="{Binding ReplaceAllCommand}"
                    ToolTip.Tip="当たるところを全部置き換える（取り消しで戻せます）" />
          </StackPanel>
        </Grid>
      </Border>

      <!--
        ListBox は既定で VirtualizingStackPanel を使い、画面に映っている行だけを
        実体化する。旧 PyQt6 実装は行ごとにウィジェットを作っていたため数千行で
        操作不能になった。
      -->
      <!--
        **本文の描き方を差し替えている途中。**
        エディタ部品（下）と、行を並べたリスト（この下）の 2 つを持ち、
        設定で切り替える。リストは文字単位の選択も行をまたぐ選択も
        作り込めなかったので、いずれ落とす。
      -->
      <views:DiffEditorView x:Name="Editors"
                            IsVisible="{Binding Shell.UseEditorPane}" />

      <!--
        patch の中身。**本文の上に重ねる。** 別のタブにすると、
        差分を見ながら patch を確かめる、ができない。
      -->
      <Border IsVisible="{Binding IsPatchOpen}" ZIndex="20"
              Background="{DynamicResource WindowBg}"
              BorderBrush="{DynamicResource DividerStrong}" BorderThickness="1"
              CornerRadius="{DynamicResource RadiusMedium}"
              Margin="40,20" Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="patch（unified 形式）" Classes="title"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon small"
                    Command="{Binding ClosePatchCommand}" ToolTip.Tip="閉じる">
              <Path Classes="icon" Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <TextBox Text="{Binding PatchText}" IsReadOnly="True"
                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                   AcceptsReturn="True"
                   VerticalContentAlignment="Top" />
        </DockPanel>
      </Border>

      <ListBox ItemsSource="{Binding VisibleRows}"
               IsVisible="{Binding !Shell.UseEditorPane}"
               SelectedIndex="{Binding SelectedRowIndex}"
               AutoScrollToSelectedItem="True"
               x:Name="RowList"
               SelectionMode="Multiple"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <!--
              **高さは可変にする。** 上下に並べるときは 2 段ぶん要る。
              固定のままだと、下の段が切れて見えなくなる。
            -->
            <Setter Property="Height"
                    Value="{Binding $parent[ItemsControl].((vm:TextCompareViewModel)DataContext).RowHeight}" />
          </Style>
          <!--
            **選んでも行の色を塗り潰さない。**
            既定では選択の背景が上に乗り、差分の赤や青が見えなくなる。
            差分の色こそが読みたいものなので、選択は**枠**で示す。
          -->
          <!--
            **枠で囲まない。** 上下に線を引いたら、全部選んだときに
            1 行ずつ切り離されて見えた（罫線の並びのように）。
            選択は左端の帯だけで示す。
          -->
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RowView">
            <Panel>
            <!--
              畳んである所を示す帯（BC の「36 FILTERED LINES」）。
              押すと開く。**隠したことを黙っていない**のが要点。
            -->
            <!--
              畳んである所。**言葉は入れない。** 形と数だけで足りる。
              左端の細い柱は、開いている行のアウトラインと同じ位置に来るので、
              「ここが畳まれている」と縦のつながりで読める。
            -->
            <Button Classes="foldband" Height="20" IsVisible="{Binding IsFoldBand}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="ここを開く"
                    Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).ExpandFoldCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="18,Auto,*">
                <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2"
                        BorderBrush="{DynamicResource DividerStrong}" BorderThickness="1"
                        Background="{DynamicResource ControlBg}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource IconPlusSmall}" Stroke="{DynamicResource FgNormal}"
                        StrokeThickness="2" StrokeLineCap="Round"
                        Width="7" Height="7" Stretch="Uniform" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding FoldCountText}" FontSize="10"
                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                           Margin="4,0,8,0" />

                <!-- 畳んだ幅を点線で示す。中身が無いことが形で分かる -->
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                        Background="{DynamicResource Divider}" />
              </Grid>
            </Button>

            <Border Background="{Binding Background}"
                    Height="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).RowHeight}"
                    IsVisible="{Binding !IsFoldBand}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="この塊を左から右へ写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToRightCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="この塊を右から左へ写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToLeftCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="この塊の先頭へ移る"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).SelectBlockCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <!--
                    対応付けの手直し。**自動の判断は必ず外す場面がある。**
                    「同じ役割だが書き方を全部変えた行」までは類似度で拾えない。
                  -->
                  <MenuItem Header="この行を繋ぐ起点にする"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).MarkForLinkCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="起点とこの行を対応させる"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).LinkRowsCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="この行の対応を外す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).UnlinkRowCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="手で付けた対応を全部取り消す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).ClearManualCommand}" />
                  <Separator />
                  <MenuItem Header="左の行を写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyLineCommand}"
                            CommandParameter="{Binding}" />
                  <!--
                    選んだ範囲をまとめて写す（BC の行単位の選択・切り貼り）。
                    **画面の順序で写す。** 飛び飛びに選んでも、貼り付けたときに
                    元の並びでないと読めない。
                  -->
                  <MenuItem Header="選んだ行を写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopySelectedLeftCommand}" />
                  <MenuItem Header="選んだ行を左右のタブ区切りで写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopySelectedBothCommand}" />
                  <MenuItem Header="左右をタブ区切りで写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyBothLinesCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </Border.ContextMenu>
              <!--
                **左右の一式を分けて、外側の向きだけ切り替える。**
                Horizontal なら横に並び、Vertical なら上下に並ぶ（BC の
                over-under layout）。テンプレートを 2 つに複製すると、
                以降どちらか片方だけ直す事故が必ず起きる。
              -->
              <StackPanel Orientation="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).RowOrientation}">
              <StackPanel Orientation="Horizontal">
                <!--
                  折りたたみの柱（Excel のアウトライン）。
                  **開いた状態でも「ここは畳める」と分かる。**
                  帯は畳んだ場所しか示さないので、開いている間は範囲が見えない。
                -->
                <Panel Width="18">
                  <!-- 縦線。範囲の途中と末尾に引く。位置は左端からの絶対値で決める -->
                  <Border Width="1" Height="11" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="8,0,0,0"
                          Background="{DynamicResource DividerStrong}"
                          IsVisible="{Binding OutlineLineAbove}" />
                  <Border Width="1" Height="11" VerticalAlignment="Bottom"
                          HorizontalAlignment="Left" Margin="8,0,0,0"
                          Background="{DynamicResource DividerStrong}"
                          IsVisible="{Binding OutlineLineBelow}" />
                  <!-- 末尾の折れ。縦線と重ねて角を繋ぐ -->
                  <Border Width="6" Height="1" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="8,10,0,0"
                          Background="{DynamicResource DividerStrong}"
                          IsVisible="{Binding OutlineFoot}" />

                  <!-- 先頭には畳む箱 -->
                  <Button Classes="outline" IsVisible="{Binding IsOutlineHead}"
                          ToolTip.Tip="ここから下をまとめて畳む"
                          Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CollapseOutlineCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconMinusSmall}" Stroke="{DynamicResource FgNormal}"
                          StrokeThickness="2" StrokeLineCap="Round"
                          Width="7" Height="7" Stretch="Uniform" />
                  </Button>
                </Panel>

                <TextBlock Classes="cell gutter" Text="{Binding LeftNumber}" />

                <!--
                  **矢印はそれぞれのペインの左端に置く（BC と同じ）。**
                  左の矢印は「左の内容を右へ送る」、右の矢印は「右の内容を左へ
                  送る」。中央にまとめて置くと、どちらの内容が動くのかを
                  矢印の向きだけで読み取ることになり、一拍考える必要がある。
                  操作したい側の手前にあれば、その側が動くと分かる。
                -->
                <!--
                  矢印と、その矢印が写す範囲の線。
                  **どこまでを写すのかを、押す前に見せる。**
                  折りたたみと同じ形にして、線の意味を覚え直さなくて済むようにする。
                -->
                <!--
                  **写しの列は本文と地の色を変える。** 同じ面の上に矢印だけが
                  浮いていると、本文の一部なのか操作するものなのかが分からない。
                  Beyond Compare も、この列を別の面として分けている。
                -->
                <Panel Width="22" Background="{DynamicResource PanelBg}">
                  <!--
                    **位置は左端からの絶対値で決める。**
                    中央揃えと余白の組み合わせだと、縦線の終点と折れの始点が
                    1〜2 画素ずれて線が途切れる。実際そうなっていた。
                    行の高さ 20 の中で、縦線の中心を y=10、柱の中心を x=10 に置く。
                  -->
                  <Border Width="1" Height="11" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineAbove}" />
                  <Border Width="1" Height="11" VerticalAlignment="Bottom"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineBelow}" />
                  <!-- 末尾の折れ。縦線と 2 画素重ねて、角が切れないようにする -->
                  <Border Width="7" Height="2" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,9,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockFoot}" />
                  <Button Classes="apply" IsVisible="{Binding CanApplyToRight}"
                          ToolTip.Tip="この塊を左から右へ写す"
                          Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToRightCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconToRight}" />
                  </Button>
                </Panel>

                <!--
                  本文。**選んだ 1 行だけが入力欄になる**（BC の Full Edit）。
                  全行を入力欄にすると、仮想化していても数千個を作ることになる。
                -->
                <!--
                  直した行の印。**本文のすぐ左に細い柱を立てる。**
                  行の色（相手と違う）とは別の情報なので、色ではなく
                  位置で分ける。
                -->
                <Border Width="3" Background="{DynamicResource EditedMark}"
                        IsVisible="{Binding LeftEdited}" />
                <Border Tag="left" Background="{Binding LeftBackground}"
                        Width="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).TextWidth}">
                  <Panel>
                    <TextBlock Classes="cell" vm:TextRuns.Value="{Binding LeftRuns}"
                               IsVisible="{Binding !IsEditing}" />
                    <TextBox Classes="inline" Text="{Binding EditLeft}"
                             IsVisible="{Binding IsEditing}"
                             IsEnabled="{Binding CanEditLeft}" />
                  </Panel>
                </Border>

              </StackPanel>

              <StackPanel Orientation="Horizontal">
                <!--
                  上下に並べるとき、右の行を左と同じ位置から始める。
                  **アウトラインの柱の幅ぶんだけ空ける** — 揃っていないと、
                  左右で桁がずれて読みにくい。
                -->
                <!--
                  **左右の境目。** どこまでが左でどこからが右かを、
                  色ではなく線で示す。行をまたいで縦に通るので、
                  目で追うときの手すりになる。
                -->
                <Border Width="1" Background="{DynamicResource DividerStrong}" />

                <Panel Width="18" Background="{DynamicResource PanelBg}" />

                <TextBlock Classes="cell gutter" Text="{Binding RightNumber}" />

                <Panel Width="22" Background="{DynamicResource PanelBg}">
                  <!--
                    **位置は左端からの絶対値で決める。**
                    中央揃えと余白の組み合わせだと、縦線の終点と折れの始点が
                    1〜2 画素ずれて線が途切れる。実際そうなっていた。
                    行の高さ 20 の中で、縦線の中心を y=10、柱の中心を x=10 に置く。
                  -->
                  <Border Width="1" Height="11" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineAbove}" />
                  <Border Width="1" Height="11" VerticalAlignment="Bottom"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineBelow}" />
                  <!-- 末尾の折れ。縦線と 2 画素重ねて、角が切れないようにする -->
                  <Border Width="7" Height="2" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,9,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockFoot}" />
                  <Button Classes="apply" IsVisible="{Binding CanApplyToLeft}"
                          ToolTip.Tip="この塊を右から左へ写す"
                          Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToLeftCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconToLeft}" />
                  </Button>
                </Panel>

                <Border Width="3" Background="{DynamicResource EditedMark}"
                        IsVisible="{Binding RightEdited}" />
                <Border Tag="right" Background="{Binding RightBackground}"
                        Width="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).TextWidth}">
                  <Panel>
                    <TextBlock Classes="cell" vm:TextRuns.Value="{Binding RightRuns}"
                               IsVisible="{Binding !IsEditing}" />
                    <TextBox Classes="inline" Text="{Binding EditRight}"
                             IsVisible="{Binding IsEditing}"
                             IsEnabled="{Binding CanEditRight}" />
                  </Panel>
                </Border>

                <TextBlock Classes="cell gutter" Text="{Binding ScoreText}" />
                <!-- 移動の印。相手側の行番号を出すので、どこへ動いたかが分かる。 -->
                <TextBlock Classes="cell" Width="52" Text="{Binding MovedText}"
                           Foreground="{DynamicResource FgMoved}" FontSize="11"
                           ToolTip.Tip="このブロックは相手側のこの行へ移動している" />
              </StackPanel>
              </StackPanel>
            </Border>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

  </DockPanel>
</UserControl>
