<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.TableCompareView"
             x:DataType="vm:TableCompareViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <Border Grid.Row="0" Classes="topbar" BorderThickness="0">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
                ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
          <Path Classes="icon" Data="{StaticResource IconHome}" />
        </Button>
        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding CompareCommand}" IsEnabled="{Binding !Busy}"
                ToolTip.Tip="列単位で比べ直す">
          <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding OpenAsTextCommand}"
                ToolTip.Tip="テキストとして比べ直す">
          <Path Classes="icon" Data="{StaticResource IconText}" />
        </Button>
        <Border Classes="vsep" />
        <CheckBox Content="同じ行も出す" IsChecked="{Binding ShowUnchanged}"
                  VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}"
                     Width="70" VerticalAlignment="Center" Margin="6,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="topbar" BorderThickness="0">
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBox Grid.Column="0" Text="{Binding LeftPath}" PlaceholderText="左の CSV / TSV" />
        <TextBlock Grid.Column="1" Text="↔" Classes="dim" VerticalAlignment="Center" Margin="10,0" />
        <TextBox Grid.Column="2" Text="{Binding RightPath}" PlaceholderText="右の CSV / TSV" />
      </Grid>
    </Border>

    <!--
      キー列。**ここが表比較の要。** 指定すれば並び順が違っても照合でき、
      指定しなければ 1 行挿入されただけで以降が全部ずれる。
    -->
    <Border Grid.Row="2" Classes="topbar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,*">
        <TextBlock Grid.Column="0" Text="キー列" FontSize="12" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBox Grid.Column="1" Text="{Binding KeyColumns}"
                 PlaceholderText="列名か番号をカンマ区切りで（空なら上から順に照合）"
                 ToolTip.Tip="この列が同じ行どうしを対応させます。並び順が違っても照合できます" />
        <TextBlock Grid.Column="2" Text="見ない列" FontSize="12" VerticalAlignment="Center"
                   Margin="12,0,8,0" />
        <TextBox Grid.Column="3" Text="{Binding IgnoredColumns}"
                 PlaceholderText="更新時刻など、毎回動いて意味の無い列"
                 ToolTip.Tip="ここに挙げた列は差分として出ません" />
      </Grid>
    </Border>

    <!--
      見出しと本文。**表計算ソフトのように見せる。**
      以前は行ごとに角丸の札を積んでいたので、列の桁が揃わず
      「表」に見えなかった。ここでは

        * 列の幅を左右と見出しで揃える（VM が測る）
        * セルに罫線を引く
        * 行番号の列を左端に固定して、Excel と同じ並びにする

      横は 1 本のスクロールで左右を一緒に動かす。**別々に動くと、
      同じ列を見比べるのに両方を合わせ直すことになる。**
    -->
    <ScrollViewer Grid.Row="3" Grid.RowSpan="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Orientation="Vertical">

        <!-- 見出しの行。左右ぶんを横に並べる -->
        <Border Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource DividerStrong}" BorderThickness="0,0,0,1"
                IsVisible="{Binding Header.Count}">
          <StackPanel Orientation="Horizontal">

            <!-- 行番号の桁（Excel の左端） -->
            <Border Width="44" Padding="4,3"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
              <TextBlock Text="行" FontSize="11" TextAlignment="Center"
                         Foreground="{DynamicResource FgDim}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Header}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TableHeaderView">
                  <Border Width="{Binding Width}" Padding="5,3"
                          BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Text}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 左右の境目。**太くする。** どこで切り替わるかが一目で要る -->
            <Border Width="3" Background="{DynamicResource DividerStrong}" />

            <Border Width="44" Padding="4,3"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
              <TextBlock Text="行" FontSize="11" TextAlignment="Center"
                         Foreground="{DynamicResource FgDim}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Header}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TableHeaderView">
                  <Border Width="{Binding Width}" Padding="5,3"
                          BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Text}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TableRowView">
              <Border Background="{Binding Background}"
                      BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">

                  <Border Width="44" Padding="4,2"
                          BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding LeftLabel}" Classes="mono" FontSize="11"
                               TextAlignment="Right"
                               Foreground="{DynamicResource FgDim}" />
                  </Border>

                  <!--
                    **セル単位で塗る。** 行ごと塗ると、どの列が動いたのかを
                    目で探すことになる。表は列が多いほどそれが効く。
                  -->
                  <ItemsControl ItemsSource="{Binding LeftCells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TableCellView">
                        <Border Width="{Binding Width}" Background="{Binding Background}"
                                Padding="5,2"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                          <TextBlock Text="{Binding Text}" Classes="mono" FontSize="12"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Width="3" Background="{DynamicResource DividerStrong}" />

                  <Border Width="44" Padding="4,2"
                          BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding RightLabel}" Classes="mono" FontSize="11"
                               TextAlignment="Right"
                               Foreground="{DynamicResource FgDim}" />
                  </Border>

                  <ItemsControl ItemsSource="{Binding RightCells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TableCellView">
                        <Border Width="{Binding Width}" Background="{Binding Background}"
                                Padding="5,2"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                          <TextBlock Text="{Binding Text}" Classes="mono" FontSize="12"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="5" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding Summary}" FontSize="11"
                   Foreground="{DynamicResource FgDim}" />
        <TextBlock Text="{Binding Message}" FontSize="11" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
