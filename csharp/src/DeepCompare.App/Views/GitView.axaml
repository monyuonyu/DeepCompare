<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.GitView"
             x:DataType="vm:GitViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- 上の帯。操作はアイコン、場所は 1 行 -->
    <Border Grid.Row="0" Classes="topbar">
      <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
              ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
        <Path Classes="icon" Data="{StaticResource IconHome}" />
      </Button>
      <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="読み直す">
          <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
        <Border Classes="vsep" />

        <Path Classes="icon dim" Data="{StaticResource IconGit}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Branch}" VerticalAlignment="Center"
                   Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />

        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding FetchCommand}"
                ToolTip.Tip="遠隔の状態を取ってくる（fetch）">
          <Path Classes="icon" Data="{StaticResource IconSave}" />
        </Button>
        <Button Classes="icon" Command="{Binding PullCommand}"
                ToolTip.Tip="遠隔の変更を取り込む（pull --ff-only）">
          <Path Classes="icon" Data="{StaticResource IconStage}" />
        </Button>
        <Button Classes="icon" Command="{Binding PushCommand}"
                ToolTip.Tip="こちらの変更を送る（push）">
          <Path Classes="icon" Data="{StaticResource IconUnstage}" />
        </Button>

        <Border Classes="vsep" />
        <TextBox Text="{Binding Path}" Width="330"
                 PlaceholderText="リポジトリの中のどこか"
                 ToolTip.Tip="{Binding Root}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}"
                     Width="70" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 左に作業ツリー、右に履歴 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="12,8">

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="作業ツリー" Classes="title" Margin="0,0,0,8"
                   ToolTip.Tip="行を開くと HEAD と作業ツリーを比べます。git の diff ではなく、こちらの比較エンジンに掛けるので、意味的な行の対応付けが効きます。" />

        <!--
          コミット。**索引に何も載っていなければ押せない。**
          押しても git が断るだけなので、その前に分かる方がよい。
        -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="10,8" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBox Text="{Binding CommitMessage}" AcceptsReturn="True" Height="56"
                     PlaceholderText="このコミットで何をしたか" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="コミット" Classes="accent" Command="{Binding CommitCommand}" />
              <Button Content="直前を書き直す" Command="{Binding AmendCommand}"
                      ToolTip.Tip="空のままなら、元の説明をそのまま使います" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GitFileRow">
                <Border Background="{Binding Background}" Classes="row">
                  <Grid ColumnDefinitions="28,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Mark}" Classes="mono"
                               FontWeight="Bold" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Display}" Classes="mono"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                 Foreground="{DynamicResource FgDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                      <Button Classes="icon" ToolTip.Tip="HEAD と作業ツリーを比べる"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).OpenFileCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconOpen}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="索引へ載せる（stage）"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).StageCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconStage}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="索引から降ろす。中身は変えない"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).UnstageCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconUnstage}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource Divider}" Width="2" />

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="枝" Classes="title" Margin="0,0,0,6" />
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding Branches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GitBranchRow">
                  <Button Classes="quiet" Margin="0,0,4,4"
                          Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).SwitchBranchCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="この枝へ切り替える">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Path Classes="icon" Data="{StaticResource IconGit}"
                            Width="12" Height="12" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TrackText}" FontSize="10"
                                 Foreground="{DynamicResource FgWarning}"
                                 IsVisible="{Binding HasTrack}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding NewBranchName}" Width="200"
                       PlaceholderText="新しい枝の名前" />
              <Button Content="作って切り替える" Command="{Binding CreateBranchCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="履歴" Classes="title" Margin="0,0,0,6"
                   ToolTip.Tip="行を選ぶと、下にそのコミットの中身が出ます。" />

        <!--
          選んだコミットの詳細。**下に置いて、履歴とは分けない。**
          別のタブへ移すと、行を選ぶたびに視線が画面をまたぐことになる。
          SourceTree と同じ配置。
        -->
        <Border DockPanel.Dock="Bottom" Height="210" Margin="0,8,0,0"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                IsVisible="{Binding HasSelectedCommit}">
          <Grid RowDefinitions="Auto,*" Margin="10,8">

            <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,6">
              <TextBlock Text="{Binding SelectedCommit.Subject}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding SelectedCommit.ShortHash}" Classes="mono" FontSize="11"
                           Foreground="{DynamicResource FgKeyword}"
                           ToolTip.Tip="このコミットのハッシュ" />
                <TextBlock Text="{Binding SelectedCommit.Author}" FontSize="11"
                           Foreground="{DynamicResource FgDim}" />
                <TextBlock Text="{Binding SelectedCommit.Ago}" FontSize="11"
                           Foreground="{DynamicResource FgDim}"
                           ToolTip.Tip="{Binding SelectedCommit.When}" />
                <TextBlock Text="{Binding CommitParents}" Classes="mono" FontSize="11"
                           Foreground="{DynamicResource FgDim}"
                           ToolTip.Tip="親のコミット。2 つ以上ならマージ" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,8,*">
              <!-- 説明の全文。1 行目だけでは、なぜそうしたかが分からない -->
              <ScrollViewer Grid.Column="0" IsVisible="{Binding HasCommitBody}">
                <SelectableTextBlock Text="{Binding CommitBody}" Classes="mono" FontSize="11"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource FgDim}" />
              </ScrollViewer>

              <ListBox Grid.Column="2" ItemsSource="{Binding CommitFiles}"
                       SelectedItem="{Binding SelectedCommitFile}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <!-- 一覧なので詰める。既定の高さだと 4 件で枠が埋まる -->
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GitCommitFileRow">
                    <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Path}">
                      <TextBlock Grid.Column="0" Text="{Binding Mark}" Classes="mono"
                                 FontSize="11" FontWeight="Bold"
                                 Foreground="{Binding MarkColour}" />
                      <TextBlock Grid.Column="1" Text="{Binding Display}" Classes="mono"
                                 FontSize="11" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="2" Classes="icon"
                              ToolTip.Tip="このコミットでの、このファイルの変化を見る"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).OpenCommitFileCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconOpen}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>

        <!--
          見出し。**本体と同じ列幅を使う。** グラフの幅は履歴の形で決まるので、
          両方が同じ値（GraphColumnWidth）を見る。
        -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding GraphColumnWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="説明" Classes="columnhead" />
          <TextBlock Grid.Column="2" Text="日時" Classes="columnhead" />
          <TextBlock Grid.Column="3" Text="作者" Classes="columnhead" />
          <TextBlock Grid.Column="4" Text="コミット" Classes="columnhead" />
        </Grid>

        <ListBox ItemsSource="{Binding Commits}"
                 SelectedItem="{Binding SelectedCommit}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <!--
              **行の高さを揃え、左右の余白を消す。** グラフの線は行をまたいで
              繋がるので、行の間に隙間があるとそこで途切れる。
            -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Height" Value="26" />
              <!--
                **中身を行の高さいっぱいに広げる。** 既定は中央寄せで、
                中身はテキストの高さ（17px ほど）にしかならない。上下に
                残った隙間でグラフの線が切れ、丸が浮いて見えていた。
              -->
              <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GitCommitRow">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding GraphWidth}" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <vm:CommitGraph Grid.Column="0" Row="{Binding Graph}" />

                <!--
                  **横並びの StackPanel に入れない。** 中の要素は幅が無限に
                  取れるので、TextTrimming が効かず、説明が隣の列へはみ出す。
                  札は Auto、説明は残り全部の Grid にする。
                -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                  <!-- 枝とタグの札。説明の前に置く（SourceTree と同じ） -->
                  <ItemsControl Grid.Column="0" Margin="0,0,4,0"
                                ItemsSource="{Binding Refs}" IsVisible="{Binding HasRefs}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GitRefChip">
                        <Border Background="{Binding Background}" CornerRadius="8"
                                Padding="5,1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <Path Data="{Binding Icon}" Fill="{Binding Foreground}"
                                  Width="11" Height="11" Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}" FontSize="10"
                                       Foreground="{Binding Foreground}"
                                       FontWeight="{Binding Weight}"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="12"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11"
                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Author}" FontSize="11"
                           Foreground="{DynamicResource FgDim}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding ShortHash}" Classes="mono" FontSize="11"
                           Foreground="{DynamicResource FgKeyword}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <!-- 下の帯 -->
    <Border Grid.Row="2" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FgWarning}"
                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
