<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.NotebookCompareView"
             x:DataType="vm:NotebookCompareViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- 上の帯 -->
    <Border Grid.Row="0" Classes="topbar" BorderThickness="0">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
                ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
          <Path Classes="icon" Data="{StaticResource IconHome}" />
        </Button>
        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding CompareCommand}" IsEnabled="{Binding !Busy}"
                ToolTip.Tip="セル単位で比べ直す">
          <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding OpenAsTextCommand}"
                ToolTip.Tip="本文だけ取り出して行単位で比べる（行内の差分を見たいとき）">
          <Path Classes="icon" Data="{StaticResource IconText}" />
        </Button>
        <Border Classes="vsep" />
        <!--
          **出力は既定で見ない。** 実行しただけで全部動くので、
          既定で見ると本当の変更が埋もれる。見たい人だけが開く。
        -->
        <CheckBox Content="出力も比べる" IsChecked="{Binding CompareOutputs}"
                  VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"
                  ToolTip.Tip="実行しただけで動くので、既定では見ません" />
        <CheckBox Content="変化なしも出す" IsChecked="{Binding ShowUnchanged}"
                  VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}"
                     Width="70" VerticalAlignment="Center" Margin="6,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="topbar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBox Grid.Column="0" Text="{Binding LeftPath}" PlaceholderText="左の .ipynb" />
        <TextBlock Grid.Column="1" Text="↔" Classes="dim" VerticalAlignment="Center" Margin="10,0" />
        <TextBox Grid.Column="2" Text="{Binding RightPath}" PlaceholderText="右の .ipynb" />
      </Grid>
    </Border>

    <!--
      言語やカーネルの変化。**セルの一覧に混ぜない。**
      付け替えただけで全セルが動くので、原因として先に目に入る必要がある。
    -->
    <Border Grid.Row="2" IsVisible="{Binding HasMetadataChange}"
            Background="{DynamicResource SubtleBg}" Padding="10,6">
      <TextBlock Text="{Binding MetadataChange}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource FgWarning}" />
    </Border>

    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding Cells}" Margin="10">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotebookCellRow">
            <Border Background="{Binding Background}" Margin="0,0,0,8" Padding="10,8"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
              <StackPanel Spacing="6">

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ChangeLabel}" FontSize="11"
                             Foreground="{DynamicResource FgDim}" />
                  <TextBlock Text="{Binding PositionLabel}" FontSize="11"
                             Foreground="{DynamicResource FgDim}" />
                  <!--
                    **出力は「あるか」だけ。** 中身（base64 の画像）を出しても
                    読めないし、それが差分を埋もれさせていた元凶。
                  -->
                  <TextBlock Text="{Binding OutputLabel}" FontSize="11"
                             IsVisible="{Binding HasOutputLabel}"
                             Foreground="{DynamicResource FgDim}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,*">
                  <Border Grid.Column="0" Background="{DynamicResource CardBg}"
                          IsVisible="{Binding HasLeft}"
                          CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6">
                    <TextBlock Text="{Binding LeftText}" Classes="mono" FontSize="12"
                               TextWrapping="NoWrap" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="↔" Classes="dim"
                             VerticalAlignment="Center" Margin="10,0" />
                  <Border Grid.Column="2" Background="{DynamicResource CardBg}"
                          IsVisible="{Binding HasRight}"
                          CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6">
                    <TextBlock Text="{Binding RightText}" Classes="mono" FontSize="12"
                               TextWrapping="NoWrap" />
                  </Border>
                </Grid>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="4" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding Summary}" FontSize="11"
                   Foreground="{DynamicResource FgDim}" />
        <TextBlock Text="{Binding Message}" FontSize="11" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
