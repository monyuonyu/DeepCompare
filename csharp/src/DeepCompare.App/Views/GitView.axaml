<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.GitView"
             x:DataType="vm:GitViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- 上の帯。操作はアイコン、場所は 1 行 -->
    <Border Grid.Row="0" Classes="topbar">
      <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
              ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
        <Path Classes="icon" Data="{StaticResource IconHome}" />
      </Button>
      <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="読み直す">
          <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
        <Border Classes="vsep" />

        <Path Classes="icon dim" Data="{StaticResource IconGit}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Branch}" VerticalAlignment="Center"
                   Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />

        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding FetchCommand}"
                ToolTip.Tip="遠隔の状態を取ってくる（fetch）">
          <Path Classes="icon" Data="{StaticResource IconSave}" />
        </Button>
        <Button Classes="icon" Command="{Binding PullCommand}"
                ToolTip.Tip="遠隔の変更を取り込む（pull --ff-only）">
          <Path Classes="icon" Data="{StaticResource IconStage}" />
        </Button>
        <Button Classes="icon" Command="{Binding PushCommand}"
                ToolTip.Tip="こちらの変更を送る（push）">
          <Path Classes="icon" Data="{StaticResource IconUnstage}" />
        </Button>

        <Border Classes="vsep" />
        <TextBox Text="{Binding Path}" Width="330"
                 PlaceholderText="リポジトリの中のどこか"
                 ToolTip.Tip="{Binding Root}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}"
                     Width="70" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 左に作業ツリー、右に履歴 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="12,8">

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="作業ツリー" Classes="title" Margin="0,0,0,8"
                   ToolTip.Tip="行を開くと HEAD と作業ツリーを比べます。git の diff ではなく、こちらの比較エンジンに掛けるので、意味的な行の対応付けが効きます。" />

        <!--
          コミット。**索引に何も載っていなければ押せない。**
          押しても git が断るだけなので、その前に分かる方がよい。
        -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="10,8" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBox Text="{Binding CommitMessage}" AcceptsReturn="True" Height="56"
                     PlaceholderText="このコミットで何をしたか" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="コミット" Classes="accent" Command="{Binding CommitCommand}" />
              <Button Content="直前を書き直す" Command="{Binding AmendCommand}"
                      ToolTip.Tip="空のままなら、元の説明をそのまま使います" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GitFileRow">
                <Border Background="{Binding Background}" Classes="row">
                  <Grid ColumnDefinitions="28,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Mark}" Classes="mono"
                               FontWeight="Bold" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Display}" Classes="mono"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                 Foreground="{DynamicResource FgDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                      <Button Classes="icon" ToolTip.Tip="HEAD と作業ツリーを比べる"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).OpenFileCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconOpen}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="索引へ載せる（stage）"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).StageCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconStage}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="索引から降ろす。中身は変えない"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).UnstageCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconUnstage}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource Divider}" Width="2" />

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="枝" Classes="title" Margin="0,0,0,6" />
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding Branches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GitBranchRow">
                  <Button Classes="quiet" Margin="0,0,4,4"
                          Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).SwitchBranchCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="この枝へ切り替える">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Path Classes="icon" Data="{StaticResource IconGit}"
                            Width="12" Height="12" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TrackText}" FontSize="10"
                                 Foreground="{DynamicResource FgWarning}"
                                 IsVisible="{Binding HasTrack}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding NewBranchName}" Width="200"
                       PlaceholderText="新しい枝の名前" />
              <Button Content="作って切り替える" Command="{Binding CreateBranchCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="履歴" Classes="title" Margin="0,0,0,8"
                   ToolTip.Tip="左でファイルを選んでから行を開くと、そのコミットでの変化を出します。" />

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Commits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GitCommitRow">
                <Border Background="{DynamicResource CardBg}" Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ShortHash}" Classes="mono" FontSize="11"
                                   Foreground="{DynamicResource FgKeyword}" />
                        <TextBlock Text="{Binding When}" FontSize="11"
                                   Foreground="{DynamicResource FgDim}" />
                        <TextBlock Text="{Binding Author}" FontSize="11"
                                   Foreground="{DynamicResource FgDim}" />
                        <TextBlock Text="{Binding MergeNote}" FontSize="11"
                                   Foreground="{DynamicResource FgWarning}"
                                   IsVisible="{Binding IsMerge}" />
                      </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Classes="icon"
                            ToolTip.Tip="左で選んだファイルの、このコミットでの変化を見る"
                            Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).OpenCommitCommand}"
                            CommandParameter="{Binding}">
                      <Path Classes="icon" Data="{StaticResource IconOpen}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- 下の帯 -->
    <Border Grid.Row="2" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FgWarning}"
                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
