<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeepCompare.App"
        xmlns:views="clr-namespace:DeepCompare.App.Views"
        x:Class="DeepCompare.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="DeepCompare"
        Width="1280" Height="820"
        MinWidth="420" MinHeight="280"
        Background="{DynamicResource WindowBg}"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full">
  <!--
    **題の帯を自前で持つ。** 既定では題の帯の下にタブ行が来るので、
    上端に 2 段の帯ができる。クライアント領域を上端まで伸ばし、
    タブ行をそのまま題の帯として使う。

    Avalonia 12 の作法（11 までの ExtendClientAreaChromeHints は無い）:

      * 伸ばした先の要素は**既定で「窓の飾り」扱い**。掴めば窓が動く
      * 押せるようにしたいものには ElementRole="User" を付ける。
        **付け忘れると押せない**（一度これで詰まった）
      * 最小化・最大化・閉じるは Avalonia が右上に描く

    題の文字は下のスタイルで消す。消さないとタブと重なる。
  -->
  <Window.Styles>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!--
      **窓のボタンも自前で描く。** Avalonia の描くものと自前のものを
      並べようとしたが、

        * 既定で 4 つ描かれる（フルスクリーンが余分）
        * 何 px 空ければ重ならないかが環境で変わる
        * 指したときだけ出るスナップの吹き出しが上に乗る

      と、隙間の調整だけで何度も往復した。**全部こちらで描けば、
      重なりようがない。**
    -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_CloseButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window:maximized Path.max">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window:maximized Path.restore">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <!-- 出す画面は今の状態の型で決まる。切り替えのための分岐をコード側に持たない。 -->
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:FolderCompareViewModel">
      <views:FolderCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:TextCompareViewModel">
      <views:TextCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:StructuredCompareViewModel">
      <views:StructuredCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:GitViewModel">
      <views:GitView />
    </DataTemplate>
    <DataTemplate DataType="vm:MergeViewModel">
      <views:MergeView />
    </DataTemplate>
    <DataTemplate DataType="vm:BinaryCompareViewModel">
      <views:BinaryCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:ImageCompareViewModel">
      <views:ImageCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:VersionCompareViewModel">
      <views:VersionCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:SnapshotViewModel">
      <views:SnapshotView />
    </DataTemplate>
    <DataTemplate DataType="vm:NotebookCompareViewModel">
      <views:NotebookCompareView />
    </DataTemplate>
    <DataTemplate DataType="vm:TableCompareViewModel">
      <views:TableCompareView />
    </DataTemplate>
  </Window.DataTemplates>

  <!--
    タブで複数の比較を同時に開く。Beyond Compare と同じ。
    フォルダー比較の一覧から次々にファイルを開くとき、1 枚しか持てないと
    前の比較が消える。見比べながら直す作業では、開いたまま行き来できることが効く。
  -->
  <DockPanel>
    <!--
      **本体と同じ色にし、下の線も引かない。** 帯だけ別の色にすると、
      上端に「窓の飾り」がもう 1 段あるように見える。VS Code のように
      題の帯からそのまま中身へ続いて見せる。選ばれているタブだけが
      浮いて見えればよい。
    -->
    <!--
      **この帯そのものが題の帯。** ElementRole="TitleBar" を付けた要素だけが
      掴んで動かせる（付けないと、ただの中身として扱われて窓が動かない）。
      二度押しでの最大化も、このロールが持っている。
    -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource WindowBg}"
            WindowDecorationProperties.ElementRole="TitleBar">
      <DockPanel>

      <!--
        右端の道具。**タブと同じ行に置く。** 別の帯を作ると、
        比較に使える高さがその分だけ減る。
      -->
      <!--
        窓のボタン。**押せるように User のロールを付ける。**
        付けないと帯（TitleBar）の一部として扱われ、押しても窓が動くだけ。
      -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                  WindowDecorationProperties.ElementRole="User"
                  VerticalAlignment="Stretch">
        <Button Classes="chrome" Click="OnMinimize" ToolTip.Tip="最小化">
          <!--
            **横線だけは伸縮させない。** 高さ 0 の図形を Uniform で
            10×10 に収めようとすると潰れて消える（実機で最小化だけが
            見えず、そこで気づいた）。
          -->
          <Path Classes="chrome" Data="M0,5 h10" Stretch="None" />
        </Button>
        <Button Classes="chrome" Click="OnMaximize" ToolTip.Tip="最大化／元に戻す">
          <!--
            最大化中は「元に戻す」の絵に変える。
            **窓の状態は疑似クラスで見る。** ViewModel に持たせると、
            OS 側で最大化されたとき（帯の二度押しや Win+↑）に追従しない。
          -->
          <Panel>
            <Path Classes="chrome max" Data="{StaticResource IconWinMaximize}" />
            <Path Classes="chrome restore" Data="{StaticResource IconWinRestore}"
                  IsVisible="False" />
          </Panel>
        </Button>
        <!-- 閉じるだけ、指したときに赤くする（Windows と同じ） -->
        <Button Classes="chrome close" Click="OnClose" ToolTip.Tip="閉じる">
          <Path Classes="chrome" Data="{StaticResource IconWinClose}" />
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                  WindowDecorationProperties.ElementRole="User"
                  VerticalAlignment="Center" Margin="6,0,8,0">
        <Button Classes="icon" Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="明るい／暗いを切り替える">
          <Panel>
            <!-- **いま押すとどうなるかを出す。** 暗いときは太陽（明るくする）。 -->
            <Path Classes="icon" Data="{StaticResource IconSun}"
                  IsVisible="{Binding !LightTheme}" />
            <Path Classes="icon" Data="{StaticResource IconMoon}"
                  IsVisible="{Binding LightTheme}" />
          </Panel>
        </Button>
        <Button Classes="icon" Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="設定">
          <Path Classes="icon" Data="{StaticResource IconSettings}" />
        </Button>
      </StackPanel>

      <!--
        ListBox を使う。**選ばれているのが 1 枚だけであることが構造に出る。**
        自前で「どれが選ばれているか」を持つと、閉じたときや入れ替えたときに必ずずれる。
      -->
      <ListBox DockPanel.Dock="Left"
               ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected}"
               WindowDecorationProperties.ElementRole="User"
               Background="Transparent" BorderThickness="0" Padding="6,5,6,0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Template">
              <ControlTemplate>
                <Border Name="TabRoot" Background="Transparent"
                        CornerRadius="6,6,0,0" Padding="12,7"
                        BorderBrush="Transparent" BorderThickness="1,1,1,0">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter>
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ Border#TabRoot">
            <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
          </Style>
          <!--
            **選ばれているタブは、色ではなく細い線で示す。**
            帯を本体と同じ色にしたので、背景を変える手が使えない
            （変えると、そこだけ別の面が乗っているように見える）。
          -->
          <Style Selector="ListBoxItem:selected /template/ Border#TabRoot">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareTab">
            <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Tooltip}">
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="このタブを閉じる"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="ほかのタブを閉じる"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).CloseOthersCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="200" />
              <Button Classes="icon" Width="18" Height="18" MinWidth="18" MinHeight="18"
                      Padding="0" IsVisible="{Binding CanClose}"
                      ToolTip.Tip="このタブを閉じる"
                      Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                      CommandParameter="{Binding}">
                <Path Classes="icon dim" Data="{StaticResource IconClose}" Width="9" Height="9" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!--
        **残りの余白が掴める場所。** 帯そのものに TitleBar を付けても、
        中の入れ物が hit-test を取ってしまい窓が動かなかった
        （実機で押しても 0px も動かず、そこで気づいた）。
        タブとボタンを端に寄せ、間に空いたものへロールを付ける。
      -->
      <Border WindowDecorationProperties.ElementRole="TitleBar"
              Background="Transparent" />
      </DockPanel>
    </Border>

    <ContentControl Content="{Binding Selected.Content}" />
  </DockPanel>
</Window>
