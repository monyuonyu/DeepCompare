<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.StructuredCompareView"
             x:DataType="vm:StructuredCompareViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 上の帯。操作はアイコン 1 段 -->
    <Border Grid.Row="0" Classes="topbar" BorderThickness="0">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon" Command="{Binding CompareCommand}" IsEnabled="{Binding !Busy}"
                ToolTip.Tip="構造として比較する。キーの順序や整形の違いは差分にしません">
          <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding OpenAsTextCommand}"
                ToolTip.Tip="テキストとして比べ直す（構造では説明しきれないとき）">
          <Path Classes="icon" Data="{StaticResource IconText}" />
        </Button>
        <Button Classes="icon" Command="{Binding SaveCommand}" ToolTip.Tip="差分を書き出す">
          <Path Classes="icon" Data="{StaticResource IconExport}" />
        </Button>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}"
                     Width="70" VerticalAlignment="Center" Margin="6,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="0" Classes="topbar" Margin="0,44,0,0" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBox Grid.Column="0" Text="{Binding LeftPath}" PlaceholderText="左の JSON" />
        <TextBlock Grid.Column="1" Text="↔" Classes="dim" VerticalAlignment="Center" Margin="10,0" />
        <TextBox Grid.Column="2" Text="{Binding RightPath}" PlaceholderText="右の JSON" />
      </Grid>
    </Border>

    <!-- 設定。既定のままで使えるので畳んでおく -->
    <Expander Grid.Row="1" Header="対応付けと除外の設定" Margin="12,10,12,0">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="4,8">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,10,8">
          <TextBlock Text="配列を対応付ける名前" FontSize="12" />
          <TextBox Text="{Binding ArrayKeys}" />
          <TextBlock FontSize="11" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                     Text="この名前の値で要素を組にします。並び順が違っても照合できます。読点か空白で区切ります。" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
          <TextBlock Text="比較しない位置（1 行に 1 つ）" FontSize="12" />
          <TextBox Text="{Binding IgnoredPaths}" AcceptsReturn="True" Height="64"
                   TextWrapping="NoWrap" />
          <TextBlock FontSize="11" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                     Text="例: $.metadata.generated_at / $.cells[*].execution_count（* は 1 段ぶんの任意）" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Spacing="16">
          <CheckBox IsChecked="{Binding ReportMoves}" Content="配列の並び順の違いも報告する" />
          <CheckBox IsChecked="{Binding StrictNumbers}" Content="1.0 と 1 を別のものとして扱う" />
        </StackPanel>
      </Grid>
    </Expander>

    <!-- 差分の一覧 -->
    <ScrollViewer Grid.Row="2" Margin="12,8">
      <ItemsControl ItemsSource="{Binding Changes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StructuralChangeRow">
            <Border Background="{Binding Background}" Classes="row">
              <Grid ColumnDefinitions="20,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Mark}" Classes="mono"
                           FontWeight="Bold" VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Path}" Classes="mono"
                             TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Left}" Classes="mono" FontSize="11"
                               Foreground="{DynamicResource FgDim}"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource FgDim}" />
                    <TextBlock Text="{Binding Right}" Classes="mono" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                  </StackPanel>
                  <TextBlock Text="{Binding TypeNote}" FontSize="11"
                             Foreground="{DynamicResource FgWarning}"
                             IsVisible="{Binding HasTypeNote}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="11"
                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Top" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 下の帯。要約と知らせ -->
    <Border Grid.Row="3" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FgWarning}"
                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
