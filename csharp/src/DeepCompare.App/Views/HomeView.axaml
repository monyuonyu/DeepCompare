<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <ScrollViewer>
    <StackPanel MaxWidth="820" Margin="24,20" Spacing="16">

      <!--
        比較の種類はサイドバーにあるので、ここには置かない。
        この画面は**保存した組み合わせだけ**を扱う。
      -->
      <StackPanel Spacing="2">
        <TextBlock Text="保存した比較" Classes="display" />
        <TextBlock Classes="hint"
                   Text="よく使う組み合わせに名前を付けて残します。そのとき何を無視していたかも一緒に覚えるので、開き直しても設定を入れ直す必要がありません。" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="左" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding LeftPath}" Margin="0,0,6,0"
                     PlaceholderText="ファイルまたはフォルダー" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding BrowseLeftFileCommand}"
                    ToolTip.Tip="ファイルを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconText}" />
            </Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding BrowseLeftFolderCommand}"
                    ToolTip.Tip="フォルダーを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconFolder}" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="右" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding RightPath}" Margin="0,0,6,0"
                     PlaceholderText="ファイルまたはフォルダー" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding BrowseRightFileCommand}"
                    ToolTip.Tip="ファイルを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconText}" />
            </Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding BrowseRightFolderCommand}"
                    ToolTip.Tip="フォルダーを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconFolder}" />
            </Button>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding SessionName}" Width="280"
                     PlaceholderText="名前（空なら自動で付ける）" />
            <Button Content="保存する" Classes="accent" Command="{Binding SaveSessionCommand}" />
          </StackPanel>

          <TextBlock Classes="hint"
                     Text="ウィンドウにドラッグ＆ドロップしても指定できます。" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FgWarning}" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Text="まだ保存されたものはありません。" Classes="hint"
                 IsVisible="{Binding !HasSessions}" />

      <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding HasSessions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SessionEntry">
            <Border Background="{DynamicResource PanelBg}" Classes="row" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Kind}" Classes="hint" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Paths}" Classes="hint"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="開く"
                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenSessionCommand}"
                        CommandParameter="{Binding}">
                  <Path Classes="icon" Data="{StaticResource IconOpen}" />
                </Button>
                <Button Grid.Column="2" Classes="icon" ToolTip.Tip="この保存を消す"
                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).RemoveSessionCommand}"
                        CommandParameter="{Binding}">
                  <Path Classes="icon" Data="{StaticResource IconClose}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
