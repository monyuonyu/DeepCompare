<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    コントロールの見た目。FluentTheme の上に重ねる。

    **方針**: 影を使わず、面の明度差と細い境界線だけで階層を作る。影は
    明暗テーマの両方で自然に見せるのが難しく、たいてい片方が濁る。

    ボタンは 3 種類だけに絞る。
      既定（何も付けない）… ほとんどの操作
      Classes="accent"     … その画面で一番やりたいこと。1 画面に 1 つ
      Classes="quiet"      … 一覧の行に並ぶ小さな操作
    種類が増えると、押す側は「どれが強いのか」を毎回考えることになる。
  -->

  <!-- ボタン -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="{DynamicResource PadControl}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrong}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgNormal}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgPressed}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
  </Style>

  <!-- その画面で一番やりたいこと。1 画面に 1 つだけ -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentFg}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentFg}" />
  </Style>

  <!-- 一覧の行に並ぶ小さな操作。枠を持たず、指したときだけ面が出る -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource PadTight}" />
    <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
  </Style>
  <Style Selector="Button.quiet /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgDim}" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgNormal}" />
  </Style>

  <!-- 入力欄 -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBg}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="{DynamicResource PadControl}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource FgNormal}" />
  </Style>

  <!-- 文字の役割。大きさではなく、太さと薄さで重要度を示す -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <!-- 面。カードと帯 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="{DynamicResource PadCard}" />
  </Style>

  <!-- 画面の上端の帯。下側にだけ境界線を引いて、本文と切る -->
  <Style Selector="Border.topbar">
    <Setter Property="Background" Value="{DynamicResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource PadBar}" />
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource StatusBarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,5" />
  </Style>

  <!-- 一覧の 1 行 -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>

  <!-- 縦の区切り。操作の群れを分ける -->
  <Style Selector="Border.vsep">
    <Setter Property="Background" Value="{DynamicResource Divider}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="4,2" />
  </Style>

  <!-- 左のサイドバー -->
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!--
    サイドバーの項目。押せる場所を広く取り、いま居る画面は面で示す。
    RadioButton を土台にするのは、**排他であることが構造に出る**から。
    自前で「どれが選ばれているか」を持つと、必ずどこかでずれる。
  -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NavRoot"
                Background="Transparent"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="10,7">
          <ContentPresenter Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource ControlBgHover}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>
