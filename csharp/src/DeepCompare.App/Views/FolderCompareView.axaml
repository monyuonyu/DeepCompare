<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.FolderCompareView"
             x:DataType="vm:FolderCompareViewModel">

  <UserControl.Styles>
    <!--
      横に長い行は、左端の名前と右端の状態を目で結ぶのが難しい。
      一行おきに薄く色を敷いて、視線が隣の行へ滑らないようにする。
    -->
    <Style Selector="ListBoxItem:nth-child(2n)">
      <Setter Property="Background" Value="{DynamicResource AltRowBg}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- 上端。操作はアイコン 1 段、細かい絞り込みは歯車の中 -->
    <Border DockPanel.Dock="Top" Classes="topbar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
                ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
          <Path Classes="icon" Data="{StaticResource IconHome}" />
        </Button>
        <Border Classes="vsep" />

        <Button Classes="icon" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="走査しなおす">
          <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
        <!--
          絞り込み。**「左だけ」「右だけ」を単独で見たい場面は多い。**
          移行漏れや消し忘れを探す作業がそれで、差異全部の中から目で拾うのは
          数が増えると現実的でなくなる。
        -->
        <ToggleButton Classes="filter" IsChecked="{Binding ShowAll}" ToolTip.Tip="全部出す">
          <Path Classes="icon" Data="{StaticResource IconFilterAll}" />
        </ToggleButton>
        <ToggleButton Classes="filter" IsChecked="{Binding ShowDifferences}"
                      ToolTip.Tip="差異のあるものだけ出す">
          <Path Classes="icon" Data="{StaticResource IconFilterDiff}" />
        </ToggleButton>
        <ToggleButton Classes="filter" IsChecked="{Binding ShowLeftOnly}"
                      ToolTip.Tip="左にしか無いものだけ出す">
          <Path Classes="icon" Data="{StaticResource IconToLeft}" />
        </ToggleButton>
        <ToggleButton Classes="filter" IsChecked="{Binding ShowRightOnly}"
                      ToolTip.Tip="右にしか無いものだけ出す">
          <Path Classes="icon" Data="{StaticResource IconToRight}" />
        </ToggleButton>
        <ToggleButton Classes="filter" IsChecked="{Binding ShowIdentical}"
                      ToolTip.Tip="中身が同じものだけ出す">
          <Path Classes="icon" Data="{StaticResource IconFilterSame}" />
        </ToggleButton>

        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding ExpandAllCommand}" ToolTip.Tip="全部開く">
          <Path Classes="icon" Data="{StaticResource IconExpand}" />
        </Button>
        <Button Classes="icon" Command="{Binding CollapseAllCommand}" ToolTip.Tip="全部閉じる">
          <Path Classes="icon" Data="{StaticResource IconCollapse}" />
        </Button>

        <Border Classes="vsep" />
        <Button Classes="icon" Command="{Binding ExportCsvCommand}" ToolTip.Tip="一覧を CSV で書き出す">
          <Path Classes="icon" Data="{StaticResource IconExport}" />
        </Button>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                     Width="70" VerticalAlignment="Center" Margin="6,0" />

        <!-- 絞り込みと比較方式。変えたら「走査しなおす」で反映する -->
        <Button Classes="icon" ToolTip.Tip="絞り込みと比較のしかた">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="330" Spacing="14" Margin="4">
                <StackPanel Spacing="6">
                  <TextBlock Text="名前で絞る" Classes="title" />
                  <TextBlock Text="対象（空で全部）" Classes="hint" />
                  <TextBox Text="{Binding IncludeNames}" PlaceholderText="*.cs *.md"
                           ToolTip.Tip="ファイルにだけ効く。ディレクトリの走査は止めない。&#x0a;* と ? が使える。空白区切りで複数。" />
                  <TextBlock Text="除外" Classes="hint" />
                  <TextBox Text="{Binding ExcludeNames}" PlaceholderText="*.generated.cs"
                           ToolTip.Tip="ファイルとディレクトリの両方に効く。" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="比較のしかた" Classes="title" />
                  <CheckBox Content="大きさと日時で比べる（中身を読まない）"
                            IsChecked="{Binding CompareByTimestamp}"
                            ToolTip.Tip="速い。数が多いときに使う。" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="時刻の許容誤差（秒）" VerticalAlignment="Center"
                               ToolTip.Tip="FAT と NTFS の間では 1〜2 秒ずれる。" />
                    <TextBox Text="{Binding TimestampTolerance}" Width="60" />
                  </StackPanel>
                  <CheckBox Content="夏時間の 1 時間を無視" IsChecked="{Binding IgnoreDaylightSaving}" />
                  <CheckBox Content="名前が変わっただけのものを探す"
                            IsChecked="{Binding DetectRenames}"
                            ToolTip.Tip="片側にしか無いファイルどうしを中身で突き合わせる。" />
                </StackPanel>

                <Button Content="走査しなおす" Classes="accent" HorizontalAlignment="Left"
                        Command="{Binding RefreshCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <Path Classes="icon" Data="{StaticResource IconSettings}" />
        </Button>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource FgDim}" />
        <TextBlock Text="{Binding RenameText}" IsVisible="{Binding HasRenames}"
                   FontSize="11" Foreground="{DynamicResource FgMoved}" />
      </StackPanel>
    </Border>

    <!--
      見出し。列の幅は下の行と同じ定義を使う。名前は伸ばすが、左右の情報は
      固定幅で右に寄せ、間に区切りを入れてどちら側かが一目で分かるようにする。
    -->
    <Grid DockPanel.Dock="Top" Margin="0,6,0,4"
          ColumnDefinitions="*,80,120,28,*,80,120">
      <TextBlock Grid.Column="0" Text="{Binding LeftRoot}" Classes="hint" Margin="10,0"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LeftRoot}" />
      <TextBlock Grid.Column="1" Text="大きさ" Classes="hint" TextAlignment="Right" />
      <TextBlock Grid.Column="2" Text="更新" Classes="hint" TextAlignment="Right" Margin="0,0,8,0" />
      <TextBlock Grid.Column="4" Text="{Binding RightRoot}" Classes="hint" Margin="10,0"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RightRoot}" />
      <TextBlock Grid.Column="5" Text="大きさ" Classes="hint" TextAlignment="Right" />
      <TextBlock Grid.Column="6" Text="更新" Classes="hint" TextAlignment="Right" Margin="0,0,8,0" />
    </Grid>
    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" />

    <Panel>
      <TextBlock Text="差異はありません。" IsVisible="{Binding IsEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource FgDim}" />

      <ListBox ItemsSource="{Binding Rows}"
               SelectedItem="{Binding Selected}"
               IsVisible="{Binding !IsEmpty}"
               Background="Transparent" BorderThickness="0"
               Margin="6,0">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderRowView">
            <Grid ColumnDefinitions="*,80,120,28,*,80,120">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいタブで比較"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).OpenRowCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="構造として比較（JSON）"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).OpenStructuredCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="画像として比較"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).OpenImageCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="版として比較（実行ファイル）"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).OpenVersionCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="バイト列として比較（16 進）"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).OpenBinaryCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="左から右へ写す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).CopyToRightCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="右から左へ写す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).CopyToLeftCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="時刻を左に合わせる"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).TouchToLeftCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="時刻を右に合わせる"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).TouchToRightCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="左を消す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).DeleteLeftCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="右を消す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).DeleteRightCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="これを一覧から外す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ExcludeCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="同じ種類を全部外す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ExcludeTypeCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="左の場所を開く"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).RevealLeftCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="右の場所を開く"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).RevealRightCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="左のパスを写す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).CopyLeftPathCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="右のパスを写す"
                            Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).CopyRightPathCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </Grid.ContextMenu>

              <!-- 左側 -->
              <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{Binding LeftBackground}" />
              <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding Indent}">
                <Button Classes="icon" Width="20" Height="20" MinWidth="20" MinHeight="20"
                        Padding="2" VerticalAlignment="Center"
                        IsVisible="{Binding HasChildren}"
                        Command="{Binding $parent[UserControl].((vm:FolderCompareViewModel)DataContext).ToggleCommand}"
                        CommandParameter="{Binding}">
                  <Path Classes="icon dim" Data="{Binding ToggleIcon}" Width="10" Height="10" />
                </Button>
                <Border Width="20" IsVisible="{Binding !HasChildren}" />
                <TextBlock Text="{Binding LeftName}" VerticalAlignment="Center"
                           Foreground="{Binding StatusBrush}"
                           TextTrimming="CharacterEllipsis" FontWeight="{Binding NameWeight}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding LeftSizeText}" TextAlignment="Right"
                         FontSize="11" Foreground="{DynamicResource FgDim}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding LeftModifiedText}" TextAlignment="Right"
                         FontSize="11" Foreground="{DynamicResource FgDim}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />

              <!-- 中央の印。差異のあるものだけ目に入ればよい -->
              <TextBlock Grid.Column="3" Text="{Binding CenterMark}" TextAlignment="Center"
                         Foreground="{DynamicResource StatusDifferent}" FontWeight="Bold"
                         FontSize="14" VerticalAlignment="Center" />

              <!-- 右側 -->
              <Border Grid.Column="4" Grid.ColumnSpan="3" Background="{Binding RightBackground}" />
              <TextBlock Grid.Column="4" Text="{Binding RightName}" Margin="{Binding Indent}"
                         Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" FontWeight="{Binding NameWeight}" />
              <TextBlock Grid.Column="5" Text="{Binding RightSizeText}" TextAlignment="Right"
                         FontSize="11" Foreground="{DynamicResource FgDim}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="6" Text="{Binding RightModifiedText}" TextAlignment="Right"
                         FontSize="11" Foreground="{DynamicResource FgDim}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

  </DockPanel>
</UserControl>
