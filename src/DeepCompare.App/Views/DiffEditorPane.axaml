<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="DeepCompare.App.Views.DiffEditorPane">

  <!--
    片側ぶんのエディタ。
    **左右で同じものを 2 つ並べる。** テンプレートを複製すると、
    以降どちらか片方だけ直す事故が必ず起きる。

    行番号はエディタの既定を使わない（詰め物の空行があるので、
    そのまま数えると元のファイルの番号とずれる）。自前の余白を
    コード側から差し込む。
  -->
  <!--
    **矢印もこの中に入れる。** 外に並べると、中央の境目を動かしたときに
    境目が「矢印の列」を広げてしまい、本文と矢印が離れて残る。
    まとまりを 1 つにして、境目には「本文のまとまり」だけを見せる。
  -->
  <Grid ColumnDefinitions="Auto,*">
  <ContentControl x:Name="Arrows" Grid.Column="0" />
  <ae:TextEditor x:Name="Editor" Grid.Column="1"
                 ShowLineNumbers="False"
                 WordWrap="False"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="{DynamicResource MonoFont}"
                 FontSize="13" />
  </Grid>
</UserControl>
