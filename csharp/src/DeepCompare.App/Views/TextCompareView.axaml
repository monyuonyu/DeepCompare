<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.TextCompareView"
             x:DataType="vm:TextCompareViewModel">

  <UserControl.Styles>
    <!-- 行の高さを固定する。仮想化は「n 行目は n * 高さ の位置」で成り立つ。 -->
    <Style Selector="TextBlock.cell">
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono,MS Gothic,monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!--
      行の中に置く入力欄。**行の高さを崩さない**ことが要点。
      高さが変わると、仮想化の「n 行目は n × 高さ」という前提が壊れる。
    -->
    <Style Selector="TextBox.inline">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.gutter">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Width" Value="52" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!--
      上端。**アイコン 1 段＋パス 1 段に畳んだ。**
      以前は 4 段あり、画面の高さの 1/4 を操作が占めていた。よく使うものだけを
      形で出し、説明はツールチップへ、細かい設定は歯車の中へ逃がす。
      Beyond Compare も操作はアイコン 1 段で、その下がパス行になっている。
    -->
    <StackPanel DockPanel.Dock="Top">

      <Border Classes="topbar" BorderThickness="0">
        <StackPanel Orientation="Horizontal" Spacing="2">

          <Button Classes="icon" Command="{Binding Shell.GoHomeCommand}"
                  ToolTip.Tip="起動画面へ戻る（比較の状態は残ります）">
            <Path Classes="icon" Data="{StaticResource IconHome}" />
          </Button>
          <Border Classes="vsep" />

          <Button Classes="icon" Command="{Binding CompareCommand}"
                  IsEnabled="{Binding !IsBusy}" ToolTip.Tip="比較する">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" />
          </Button>

          <Border Classes="vsep" />

          <Button Classes="icon" Command="{Binding PreviousDifferenceCommand}"
                  ToolTip.Tip="前の差分へ">
            <Path Classes="icon" Data="{StaticResource IconPrev}" />
          </Button>
          <Button Classes="icon" Command="{Binding NextDifferenceCommand}"
                  ToolTip.Tip="次の差分へ">
            <Path Classes="icon" Data="{StaticResource IconNext}" />
          </Button>

          <!-- 差分だけに絞る。押している状態が面で分かる -->
          <ToggleButton Classes="filter" IsChecked="{Binding ChangesOnly}"
                        ToolTip.Tip="変更のある行だけを出す">
            <Path Classes="icon" Data="{StaticResource IconFilterDiff}" />
          </ToggleButton>
          <!--
            上下に並べる（BC の over-under layout）。
            **横に長い行のときに効く。** 左右だと 1 行の幅が半分になる。
          -->
          <ToggleButton Classes="filter" IsChecked="{Binding OverUnder}"
                        ToolTip.Tip="上下に並べる（横に長い行を読むとき）">
            <Path Classes="icon" Data="{StaticResource IconOverUnder}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding ShowWhitespace}"
                        ToolTip.Tip="空白・タブを記号で見せる">
            <Path Classes="icon" Data="{StaticResource IconWhitespace}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding FullEdit}"
                        ToolTip.Tip="本文の中で直接直す（選んだ行が入力欄になります）">
            <Path Classes="icon" Data="{StaticResource IconEdit}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding ShowDetails}"
                        ToolTip.Tip="選んだ行を下に出す（そこで直せます）">
            <Path Classes="icon" Data="{StaticResource IconDetails}" />
          </ToggleButton>

          <Border Classes="vsep" />

          <Button Classes="icon" Command="{Binding UndoCommand}"
                  ToolTip.Tip="反映を取り消す。保存した後でも遡れる">
            <Path Classes="icon" Data="{StaticResource IconUndo}" />
          </Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="やり直す">
            <Path Classes="icon" Data="{StaticResource IconRedo}" />
          </Button>

          <Border Classes="vsep" />

          <!-- 保存は 1 つに畳む。左右の矢印は「反映の向き」で使うので、
               同じ形を保存に流用すると意味がぶつかる -->
          <Button Classes="icon" ToolTip.Tip="保存する">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="左のファイルを保存" Command="{Binding SaveLeftCommand}" />
                <MenuItem Header="右のファイルを保存" Command="{Binding SaveRightCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconSave}" />
          </Button>

          <!-- 未保存があることは、点だけで足りる -->
          <Ellipse Width="7" Height="7" Fill="{DynamicResource FgInline}"
                   VerticalAlignment="Center" Margin="2,0"
                   IsVisible="{Binding HasUnsavedChanges}"
                   ToolTip.Tip="保存していない変更があります" />

          <Border Classes="vsep" />

          <Button Classes="icon" ToolTip.Tip="差分を書き出す">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="unified 形式（patch で適用できる）"
                          Command="{Binding ExportUnifiedCommand}" />
                <MenuItem Header="HTML（左右を並べた表）"
                          Command="{Binding ExportHtmlCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconExport}" />
          </Button>

          <Border Classes="vsep" />

          <!-- 検索。よく使うのでツールバーに出す -->
          <TextBox Text="{Binding SearchText}" Width="150" Height="30"
                   PlaceholderText="検索"
                   ToolTip.Tip="左右どちらの本文に当たっても、その行へ移る" />
          <Button Classes="icon" Command="{Binding FindPreviousCommand}" ToolTip.Tip="前を探す">
            <Path Classes="icon" Data="{StaticResource IconPrev}" />
          </Button>
          <Button Classes="icon" Command="{Binding FindNextCommand}" ToolTip.Tip="次を探す">
            <Path Classes="icon" Data="{StaticResource IconNext}" />
          </Button>
          <TextBlock Text="{Binding SearchStatus}" Classes="hint" VerticalAlignment="Center"
                     Margin="4,0" />

          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                       Width="70" VerticalAlignment="Center" Margin="6,0" />

          <!--
            細かい設定は歯車の中へ。**毎回は触らないが、無いと困るもの**の置き場。
            常時出していると、よく使う操作を探す邪魔になる。
          -->
          <Button Classes="icon" Command="{Binding CompareClipboardCommand}"
                  ToolTip.Tip="左のファイルとクリップボードの中身を比べる">
            <Path Classes="icon" Data="{StaticResource IconClipboard}" />
          </Button>

          <Button Classes="icon" HorizontalAlignment="Right" ToolTip.Tip="比較の設定">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="330" Spacing="14" Margin="4">

                  <StackPanel Spacing="6">
                    <TextBlock Text="重要でない差分" Classes="title" />
                    <TextBlock Classes="hint"
                               Text="ここで指定した違いは対応付けの段階から無視されるので、表示だけでなく行の並びそのものが変わります。" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="空白" VerticalAlignment="Center"
                                 Margin="0,0,10,6" />
                      <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding WhitespaceModeIndex}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <ComboBoxItem Content="そのまま" />
                        <ComboBoxItem Content="行末のみ" />
                        <ComboBoxItem Content="行頭と行末" />
                        <ComboBoxItem Content="連続空白を 1 つ" />
                        <ComboBoxItem Content="すべて" />
                      </ComboBox>
                      <CheckBox Grid.Row="1" Grid.Column="1" Content="大文字小文字を区別しない"
                                IsChecked="{Binding IgnoreCase}" />
                    </Grid>
                    <TextBlock Text="無視する正規表現（1 行に 1 つ）" Classes="hint" />
                    <TextBox Text="{Binding IgnoredPatterns}" Height="54" AcceptsReturn="True"
                             FontSize="11" PlaceholderText="\d{4}-\d{2}-\d{2}" />
                    <TextBlock Text="{Binding ImportanceError}"
                               Foreground="{DynamicResource FgWarning}"
                               TextWrapping="Wrap" FontSize="11" />
                    <Button Content="適用して比較しなおす" Classes="accent"
                            HorizontalAlignment="Left"
                            Command="{Binding ApplyImportanceCommand}" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="対応とみなす類似度" Classes="title" />
                    <TextBlock Classes="hint"
                               Text="これを下回る行同士は、対にせず削除と追加として別々に並べます。短いコード行は似ていても値が伸びにくいので、対応が取れないときは下げてください。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Slider Value="{Binding PairThreshold}" Minimum="0" Maximum="0.95"
                              Width="220" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding PairThreshold, StringFormat={}{0:F2}}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="差分の前後に残す行" Classes="title" />
                    <TextBlock Classes="hint" Text="「変更のある行だけ」のときに、前後を何行残すか。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Slider Value="{Binding ContextLines}" Minimum="0" Maximum="10"
                              Width="220" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ContextLines, StringFormat={}{0:F0}}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="検索のしかた" Classes="title" />
                    <CheckBox Content="正規表現として扱う" IsChecked="{Binding SearchUseRegex}" />
                    <CheckBox Content="大文字小文字を区別する" IsChecked="{Binding SearchMatchCase}" />
                    <CheckBox Content="単語として一致するものだけ" IsChecked="{Binding SearchWholeWord}" />
                    <CheckBox Content="端まで来たら反対側から続ける" IsChecked="{Binding SearchWrap}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="探す側" VerticalAlignment="Center" />
                      <ComboBox SelectedIndex="{Binding SearchSide}" Width="130">
                        <ComboBoxItem Content="両方" />
                        <ComboBoxItem Content="左だけ" />
                        <ComboBoxItem Content="右だけ" />
                      </ComboBox>
                    </StackPanel>
                  </StackPanel>

                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconSettings}" />
          </Button>

        </StackPanel>
      </Border>

      <!-- パスの行。左右で対になるので、同じ幅で並べる -->
      <Border Classes="topbar">
        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <TextBox Text="{Binding LeftPath}" HorizontalAlignment="Stretch" Width="NaN"
                     PlaceholderText="左のファイル" />
            <Button Classes="icon" Command="{Binding BrowseLeftCommand}" ToolTip.Tip="左のファイルを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconBrowse}" />
            </Button>
          </StackPanel>

          <TextBlock Grid.Column="1" Text="↔" Classes="dim" VerticalAlignment="Center"
                     Margin="10,0" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <TextBox Text="{Binding RightPath}" HorizontalAlignment="Stretch" Width="NaN"
                     PlaceholderText="右のファイル" />
            <Button Classes="icon" Command="{Binding BrowseRightCommand}" ToolTip.Tip="右のファイルを選ぶ">
              <Path Classes="icon" Data="{StaticResource IconBrowse}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>

    <!--
      選んだ行を全幅で出し、**その場で直せる**（BC の Text Details）。
      本文の側を編集できるようにすると、仮想化した一覧の中に入力欄を置くことに
      なり、行の高さと選択の扱いが一気に難しくなる。BC も同じ理由でここに置く。
      横に長い行を折り返さずに読めるという利点もある。
    -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
            Padding="10,8" IsVisible="{Binding ShowDetails}">
      <Grid ColumnDefinitions="*,8,*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    Margin="2,0,0,3">
          <TextBlock Text="{Binding DetailLeftLabel}" Classes="hint" VerticalAlignment="Center" />
          <!--
            文字の対応で見る（BC の Alignment Details）。
            **色だけでは、片方にしか無い文字があると桁がずれて読めない。**
          -->
          <ToggleButton Classes="filter" IsChecked="{Binding DetailAsAlignment}"
                        ToolTip.Tip="下の帯で、左右の文字の対応を桁を揃えて見る">
            <Path Classes="icon" Data="{StaticResource IconAlignment}" />
          </ToggleButton>
          <ToggleButton Classes="filter" IsChecked="{Binding DetailAsHex}"
                        Padding="6,2" MinHeight="18"
                        ToolTip.Tip="バイトで見る（空白でも分からないときの最後の拠り所）">
            <TextBlock Text="16 進" FontSize="10" />
          </ToggleButton>
        </StackPanel>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DetailRightLabel}"
                   Classes="hint" Margin="2,0,0,3" />

        <!-- 文字で見る（直せる） -->
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DetailLeft}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="13"
                 IsEnabled="{Binding CanEditLeftDetail}"
                 IsVisible="{Binding DetailShowsText}"
                 AcceptsReturn="False" />
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DetailRight}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="13"
                 IsEnabled="{Binding CanEditRightDetail}"
                 IsVisible="{Binding DetailShowsText}"
                 AcceptsReturn="False" />

        <!-- バイトで見る（読むだけ。ここから直すのは危ないので許さない） -->
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DetailLeftHex}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 IsReadOnly="True" IsVisible="{Binding DetailAsHex}" />
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DetailRightHex}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 IsReadOnly="True" IsVisible="{Binding DetailAsHex}" />

        <!--
          文字の対応（BC の Alignment Details）。
          **左右をまたいで 1 つの欄に出す。** 桁を揃えて見せるのが目的なので、
          左右の欄に分けると意味が無い。
        -->
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                 Text="{Binding DetailAlignment}"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 IsReadOnly="True" IsVisible="{Binding DetailAsAlignment}"
                 AcceptsReturn="True" />

        <Button Grid.Row="1" Grid.Column="3" Classes="accent" Margin="8,0,0,0"
                Content="直す" Command="{Binding ApplyDetailCommand}"
                IsVisible="{Binding DetailShowsText}"
                ToolTip.Tip="直した内容を本文へ戻す。取り消しで元に戻せる" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource FgDim}" />
        <!--
          「同じに見えるのに一致しない」の原因を、聞かれる前に出す。
          符号化と改行を出しているのと同じ理由。
        -->
        <TextBlock Text="{Binding InvisibleWarning}" FontSize="11"
                   Foreground="{DynamicResource FgWarning}"
                   IsVisible="{Binding HasInvisibleWarning}" />
        <!--
          手で付けた対応があることは**必ず見える場所に出す。**
          自動の結果だと思って読まれると、なぜそう並ぶのか分からなくなる。
        -->
        <TextBlock Text="{Binding ManualNote}" FontSize="11"
                   Foreground="{DynamicResource Accent}"
                   IsVisible="{Binding ManualNote,
                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!--
      **意味的な対応付けが効いていないことを黙らない。**
      この道具の売りなので、効いていないと思われずに使われるのが一番困る。

      **状態バーの中に入れない。** あそこは横並びなので幅が無限に取れ、
      TextWrapping が効かずに右端で切れる。長い文は自分の行を持たせる。
    -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar"
            IsVisible="{Binding HasModelWarning}">
      <TextBlock Text="{Binding ModelWarning}" FontSize="11"
                 Foreground="{DynamicResource FgWarning}" TextWrapping="Wrap" />
    </Border>

    <!--
      右端に差分の地図。全体のどこに差分があるかを示し、押すとそこへ飛ぶ。
      差分ビューは画面に入る 40 行ほどしか見せないので、これが無いと
      2000 行のファイルで今どこに居るのかが掴めない。
    -->
    <vm:DiffMap DockPanel.Dock="Left"
                Rows="{Binding VisibleRows}"
                ViewStart="{Binding MapViewStart}"
                ViewSize="{Binding MapViewSize}"
                ClickedPosition="{Binding MapClicked, Mode=TwoWay}"
                CurrentLine="{Binding SelectedRowIndex}"
                IsVisible="{Binding !ShowPlaceholder}"
                ToolTip.Tip="差分の位置。押すか、押したままなぞると、そこへ移ります" />

    <Panel>
      <TextBlock Text="{Binding Placeholder}" IsVisible="{Binding ShowPlaceholder}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" />

      <!--
        ListBox は既定で VirtualizingStackPanel を使い、画面に映っている行だけを
        実体化する。旧 PyQt6 実装は行ごとにウィジェットを作っていたため数千行で
        操作不能になった。
      -->
      <ListBox ItemsSource="{Binding VisibleRows}"
               IsVisible="{Binding !ShowPlaceholder}"
               SelectedIndex="{Binding SelectedRowIndex}"
               AutoScrollToSelectedItem="True"
               x:Name="RowList"
               SelectionMode="Multiple"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <!--
              **高さは可変にする。** 上下に並べるときは 2 段ぶん要る。
              固定のままだと、下の段が切れて見えなくなる。
            -->
            <Setter Property="Height"
                    Value="{Binding $parent[ItemsControl].((vm:TextCompareViewModel)DataContext).RowHeight}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RowView">
            <Panel>
            <!--
              畳んである所を示す帯（BC の「36 FILTERED LINES」）。
              押すと開く。**隠したことを黙っていない**のが要点。
            -->
            <!--
              畳んである所。**言葉は入れない。** 形と数だけで足りる。
              左端の細い柱は、開いている行のアウトラインと同じ位置に来るので、
              「ここが畳まれている」と縦のつながりで読める。
            -->
            <Button Classes="foldband" Height="20" IsVisible="{Binding IsFoldBand}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="ここを開く"
                    Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).ExpandFoldCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="18,Auto,*">
                <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2"
                        BorderBrush="{DynamicResource DividerStrong}" BorderThickness="1"
                        Background="{DynamicResource ControlBg}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource IconPlusSmall}" Stroke="{DynamicResource FgNormal}"
                        StrokeThickness="2" StrokeLineCap="Round"
                        Width="7" Height="7" Stretch="Uniform" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding FoldCountText}" FontSize="10"
                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                           Margin="4,0,8,0" />

                <!-- 畳んだ幅を点線で示す。中身が無いことが形で分かる -->
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                        Background="{DynamicResource Divider}" />
              </Grid>
            </Button>

            <Border Background="{Binding Background}"
                    Height="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).RowHeight}"
                    IsVisible="{Binding !IsFoldBand}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="この塊を左から右へ写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToRightCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="この塊を右から左へ写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToLeftCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="この塊の先頭へ移る"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).SelectBlockCommand}"
                            CommandParameter="{Binding}" />
                  <Separator />
                  <!--
                    対応付けの手直し。**自動の判断は必ず外す場面がある。**
                    「同じ役割だが書き方を全部変えた行」までは類似度で拾えない。
                  -->
                  <MenuItem Header="この行を繋ぐ起点にする"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).MarkForLinkCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="起点とこの行を対応させる"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).LinkRowsCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="この行の対応を外す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).UnlinkRowCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="手で付けた対応を全部取り消す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).ClearManualCommand}" />
                  <Separator />
                  <MenuItem Header="左の行を写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyLineCommand}"
                            CommandParameter="{Binding}" />
                  <!--
                    選んだ範囲をまとめて写す（BC の行単位の選択・切り貼り）。
                    **画面の順序で写す。** 飛び飛びに選んでも、貼り付けたときに
                    元の並びでないと読めない。
                  -->
                  <MenuItem Header="選んだ行を写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopySelectedLeftCommand}" />
                  <MenuItem Header="選んだ行を左右のタブ区切りで写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopySelectedBothCommand}" />
                  <MenuItem Header="左右をタブ区切りで写す"
                            Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyBothLinesCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </Border.ContextMenu>
              <!--
                **左右の一式を分けて、外側の向きだけ切り替える。**
                Horizontal なら横に並び、Vertical なら上下に並ぶ（BC の
                over-under layout）。テンプレートを 2 つに複製すると、
                以降どちらか片方だけ直す事故が必ず起きる。
              -->
              <StackPanel Orientation="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).RowOrientation}">
              <StackPanel Orientation="Horizontal">
                <!--
                  折りたたみの柱（Excel のアウトライン）。
                  **開いた状態でも「ここは畳める」と分かる。**
                  帯は畳んだ場所しか示さないので、開いている間は範囲が見えない。
                -->
                <Panel Width="18">
                  <!-- 縦線。範囲の途中と末尾に引く。位置は左端からの絶対値で決める -->
                  <Border Width="1" Height="11" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="8,0,0,0"
                          Background="{DynamicResource DividerStrong}"
                          IsVisible="{Binding OutlineLineAbove}" />
                  <Border Width="1" Height="11" VerticalAlignment="Bottom"
                          HorizontalAlignment="Left" Margin="8,0,0,0"
                          Background="{DynamicResource DividerStrong}"
                          IsVisible="{Binding OutlineLineBelow}" />
                  <!-- 末尾の折れ。縦線と重ねて角を繋ぐ -->
                  <Border Width="6" Height="1" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="8,10,0,0"
                          Background="{DynamicResource DividerStrong}"
                          IsVisible="{Binding OutlineFoot}" />

                  <!-- 先頭には畳む箱 -->
                  <Button Classes="outline" IsVisible="{Binding IsOutlineHead}"
                          ToolTip.Tip="ここから下をまとめて畳む"
                          Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CollapseOutlineCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconMinusSmall}" Stroke="{DynamicResource FgNormal}"
                          StrokeThickness="2" StrokeLineCap="Round"
                          Width="7" Height="7" Stretch="Uniform" />
                  </Button>
                </Panel>

                <TextBlock Classes="cell gutter" Text="{Binding LeftNumber}" />

                <!--
                  **矢印はそれぞれのペインの左端に置く（BC と同じ）。**
                  左の矢印は「左の内容を右へ送る」、右の矢印は「右の内容を左へ
                  送る」。中央にまとめて置くと、どちらの内容が動くのかを
                  矢印の向きだけで読み取ることになり、一拍考える必要がある。
                  操作したい側の手前にあれば、その側が動くと分かる。
                -->
                <!--
                  矢印と、その矢印が写す範囲の線。
                  **どこまでを写すのかを、押す前に見せる。**
                  折りたたみと同じ形にして、線の意味を覚え直さなくて済むようにする。
                -->
                <Panel Width="22">
                  <!--
                    **位置は左端からの絶対値で決める。**
                    中央揃えと余白の組み合わせだと、縦線の終点と折れの始点が
                    1〜2 画素ずれて線が途切れる。実際そうなっていた。
                    行の高さ 20 の中で、縦線の中心を y=10、柱の中心を x=10 に置く。
                  -->
                  <Border Width="1" Height="11" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineAbove}" />
                  <Border Width="1" Height="11" VerticalAlignment="Bottom"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineBelow}" />
                  <!-- 末尾の折れ。縦線と 2 画素重ねて、角が切れないようにする -->
                  <Border Width="7" Height="2" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,9,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockFoot}" />
                  <Button Classes="apply" IsVisible="{Binding CanApplyToRight}"
                          ToolTip.Tip="この塊を左から右へ写す"
                          Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToRightCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconToRight}" />
                  </Button>
                </Panel>

                <!--
                  本文。**選んだ 1 行だけが入力欄になる**（BC の Full Edit）。
                  全行を入力欄にすると、仮想化していても数千個を作ることになる。
                -->
                <Border Background="{Binding LeftBackground}"
                        Width="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).TextWidth}">
                  <Panel>
                    <TextBlock Classes="cell" Inlines="{Binding LeftInlines}"
                               IsVisible="{Binding !IsEditing}" />
                    <TextBox Classes="inline" Text="{Binding EditLeft}"
                             IsVisible="{Binding IsEditing}"
                             IsEnabled="{Binding CanEditLeft}" />
                  </Panel>
                </Border>

              </StackPanel>

              <StackPanel Orientation="Horizontal">
                <!--
                  上下に並べるとき、右の行を左と同じ位置から始める。
                  **アウトラインの柱の幅ぶんだけ空ける** — 揃っていないと、
                  左右で桁がずれて読みにくい。
                -->
                <Panel Width="18" />

                <TextBlock Classes="cell gutter" Text="{Binding RightNumber}" />

                <Panel Width="22">
                  <!--
                    **位置は左端からの絶対値で決める。**
                    中央揃えと余白の組み合わせだと、縦線の終点と折れの始点が
                    1〜2 画素ずれて線が途切れる。実際そうなっていた。
                    行の高さ 20 の中で、縦線の中心を y=10、柱の中心を x=10 に置く。
                  -->
                  <Border Width="1" Height="11" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineAbove}" />
                  <Border Width="1" Height="11" VerticalAlignment="Bottom"
                          HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockLineBelow}" />
                  <!-- 末尾の折れ。縦線と 2 画素重ねて、角が切れないようにする -->
                  <Border Width="7" Height="2" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Margin="10,9,0,0"
                          Background="{DynamicResource ApplyArrow}"
                          IsVisible="{Binding BlockFoot}" />
                  <Button Classes="apply" IsVisible="{Binding CanApplyToLeft}"
                          ToolTip.Tip="この塊を右から左へ写す"
                          Command="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).CopyToLeftCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconToLeft}" />
                  </Button>
                </Panel>

                <Border Background="{Binding RightBackground}"
                        Width="{Binding $parent[UserControl].((vm:TextCompareViewModel)DataContext).TextWidth}">
                  <Panel>
                    <TextBlock Classes="cell" Inlines="{Binding RightInlines}"
                               IsVisible="{Binding !IsEditing}" />
                    <TextBox Classes="inline" Text="{Binding EditRight}"
                             IsVisible="{Binding IsEditing}"
                             IsEnabled="{Binding CanEditRight}" />
                  </Panel>
                </Border>

                <TextBlock Classes="cell gutter" Text="{Binding ScoreText}" />
                <!-- 移動の印。相手側の行番号を出すので、どこへ動いたかが分かる。 -->
                <TextBlock Classes="cell" Width="52" Text="{Binding MovedText}"
                           Foreground="{DynamicResource FgMoved}" FontSize="11"
                           ToolTip.Tip="このブロックは相手側のこの行へ移動している" />
              </StackPanel>
              </StackPanel>
            </Border>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

  </DockPanel>
</UserControl>
