# ==============================
# .gitignore
# ==============================

# Python のキャッシュ・バイナリファイル
__pycache__/
*.pyc
*.pyo
*.pyd

# 仮想環境（.venv）
.venv/

# VSCode の設定ファイル
.vscode/


# 参照実装用の venv
.venv-ref/

# モデルの元データと中間物（生成できるので追跡しない）
# assets/minilm.dcm だけは exe に埋め込む実体なので追跡する。
assets/src/
assets/minilm-f32.dcm

# 多言語モデルは Releases に置いてある（tools/fetch-model.sh で取る）。
# **git に入れない。** 114MB は GitHub の 100MiB 制限を超えるうえ、
# 差し替えるたびにその分が履歴へ永久に積み上がる。
assets/multilingual-src/
assets/multilingual.dcm
assets/multilingual.vocab
assets/multilingual-ja.dcm
assets/multilingual-ja.vocab

# .NET のビルド生成物
bin/
obj/
*.user
