<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             xmlns:views="clr-namespace:DeepCompare.App.Views"
             x:Class="DeepCompare.App.Views.DiffEditorView">

  <!--
    左右のエディタ。

    **縦は同じだけ動き、横はそれぞれ動く。** 同じ行を見比べるのが目的なので
    縦は揃っていないと意味が無い。一方、横は片方だけ長い行があるので、
    まとめて動かすと読みたい側が動かせない（Beyond Compare も同じ）。

    中央の境目は掴んで動かせる。左右で見たい量は場面によって変わる。
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="80" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="80" />
    </Grid.ColumnDefinitions>

    <views:DiffEditorPane x:Name="LeftPane" Grid.Column="0" />

    <!--
      写しの矢印。**左右それぞれの脇に置く。**
      左の脇のものは「右へ写す」、右の脇のものは「左へ写す」。
      行に貼り付いて動く（中で位置を測っている）。
    -->
    <ContentControl x:Name="LeftArrows" Grid.Column="1" />

    <GridSplitter Grid.Column="2" Width="4" MinWidth="4"
                  Background="{DynamicResource DividerStrong}"
                  ResizeDirection="Columns" />

    <ContentControl x:Name="RightArrows" Grid.Column="3" />

    <views:DiffEditorPane x:Name="RightPane" Grid.Column="4" />
  </Grid>
</UserControl>
