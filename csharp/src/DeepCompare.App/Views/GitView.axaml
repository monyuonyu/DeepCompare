<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeepCompare.App"
             x:Class="DeepCompare.App.Views.GitView"
             x:DataType="vm:GitViewModel">

  <UserControl.Styles>
    <!-- monospace 単体では解決できない環境がある。代替を並べる。 -->
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono,MS Gothic,monospace" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- 上の帯 -->
    <Border Grid.Row="0" Background="{DynamicResource PanelBg}" Padding="12,10">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Git" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
          <TextBlock Text="{Binding Branch}" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgKeyword}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Root}" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                     MaxWidth="520" />
          <Button Content="読み直す" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="場所" VerticalAlignment="Center" />
          <TextBox Text="{Binding Path}" Width="520"
                   PlaceholderText="リポジトリの中のどこか" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 左に作業ツリー、右に履歴 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="12,8">

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="作業ツリー" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{DynamicResource FgDim}"
                   Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="行を開くと HEAD と作業ツリーを比べます。git の diff ではなく、こちらの比較エンジンに掛けます。" />

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GitFileRow">
                <Border Background="{Binding Background}" CornerRadius="3"
                        Padding="8,5" Margin="0,0,0,3">
                  <Grid ColumnDefinitions="28,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Mark}" Classes="mono"
                               FontWeight="Bold" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Display}" Classes="mono"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                 Foreground="{DynamicResource FgDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <Button Content="開く" FontSize="11" Padding="8,3"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).OpenFileCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="stage" FontSize="11" Padding="8,3"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).StageCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="降ろす" FontSize="11" Padding="8,3"
                              Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).UnstageCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource Divider}" Width="2" />

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="履歴" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{DynamicResource FgDim}"
                   Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="左でファイルを選んでから行を開くと、そのコミットでの変化を出します。" />

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Commits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GitCommitRow">
                <Border Background="{DynamicResource CardBg}" CornerRadius="3"
                        Padding="8,5" Margin="0,0,0,3">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ShortHash}" Classes="mono" FontSize="11"
                                   Foreground="{DynamicResource FgKeyword}" />
                        <TextBlock Text="{Binding When}" FontSize="11"
                                   Foreground="{DynamicResource FgDim}" />
                        <TextBlock Text="{Binding Author}" FontSize="11"
                                   Foreground="{DynamicResource FgDim}" />
                        <TextBlock Text="{Binding MergeNote}" FontSize="11"
                                   Foreground="{DynamicResource FgWarning}"
                                   IsVisible="{Binding IsMerge}" />
                      </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="開く" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[UserControl].((vm:GitViewModel)DataContext).OpenCommitCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- 下の帯 -->
    <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Text="読み込み中…" VerticalAlignment="Center" FontSize="12"
                   IsVisible="{Binding Busy}" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FgWarning}"
                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
